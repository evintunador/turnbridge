n  /** Stable ordering key within the conversation (source line index). */\n  seq: number;\n  /**\n   * The conversation this one was spawned from, when it is a sub-conversation\n   * — a Claude Code sidechain, an opencode subagent session. Sub-conversations\n   * get their own `id` (so `show` can isolate one) and point back here (so a\n   * consumer can reassemble the tree); both halves are needed because a\n   * subagent's turns are neither part of its parent's turn sequence nor\n   * meaningful without knowing whose subagent it was.\n   *\n   * Part of event identity, like the rest of `ConversationRef`: it is stated\n   * by the source, stable across rescans, and distinguishes a subagent's turn\n   * from an identical-looking parent turn.\n   */\n  parent?: string;\n}\n\nexport interface EventLink {\n  /** e.g. \"redacts\", \"supersedes\", \"annotates\", \"replies_to\" */\n  rel: string;\n  /** Target event id. */\n  target: string;\n}\n\nexport interface EvidenceEvent {\n  /** \"ev1-\" + sha256 of the identity subset (see eventId). */\n  id: string;\n  schema: typeof SCHEMA_VERSION;\n  kind: string;\n  /** When the content happened, ISO 8601 UTC (from the source when known). */\n  occurred_at: string;\n  /** When this event was appended to the ledger. Not part of identity. */\n  recorded_at: string;\n  actor: Actor;\n  producer: Producer;\n  /** IANA media type of `content`; defaults to application/json. */\n  media_type?: string;\n  /** The visible content itself, stored inline and never reinterpreted. */\n  content: unknown;\n  /** Repository context at capture time. Not part of identity. */\n  context?: RepoContext;\n  conversation?: ConversationRef;\n  links?: EventLink[];\n  /**\n   * Opaque source-native payload for lossless export, e.g. the original\n   * transcript line(s). Versioned by `format`. Not part of identity.\n   */\n  raw?: { format: string; data: unknown };\n  /**\n   * What the ledger could resolve, at capture time, of pointers the source\n   * line only names. A Claude Code `file-history-snapshot` says a file's\n   * bytes live at `<backup file>` under a machine-local cache directory; this\n   * is where the sha256 and size the ledger read from that file go, so the\n   * record can be verified later even though the cache itself is prunable and\n   * unshareable.\n   *\n   * Excluded from the identity subset, and that exclusion is the point: the\n   * same transcript line resolves differently on a machine without the cache,\n   * or after the cache is pruned, and identity must answer \"which piece of\n   * source material is this\", not \"what could this machine see at the time\".\n   * Folding it in would make a rescan after a prune duplicate every snapshot\n   * rather than dedup it.\n   *\n   * Holds derived facts about local state — digests, sizes, counts — never\n   * file bodies: the redaction stack walks `content` and `raw.data`, not this,\n   * so anything secret-bearing put here would bypass it.\n   */\n  resolved?: Record<string, unknown>;\n  /**\n   * Capture-time redaction records (rule id, ruleset version, fingerprint,\n   * location path), present when the capture-tier ruleset rewrote part of\n   * `content`/`raw.data` before this event was finalized. Deliberately\n   * excluded from the identity subset: the rewritten `content` already\n   * determines `id`, so including this here would double-count the same\n   * fact and would churn ids on ruleset upgrades even when the visible\n   * content is unchanged.\n   */\n  redactions?: RedactionRecord[];\n}\n\n/** Fields an adapter supplies; id/schema/recorded_at are filled at append. */\nexport type EventDraft = Omit<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\"> &\n  Partial<Pick<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\">>;\n\n/**\n * Event identity is derived from the durable, source-determined subset so\n * that re-scanning the same source material always yields the same id\n * (idempotent capture). Volatile provenance — recorded_at, context, raw,\n * producer.version/tool — is deliberately excluded: a re-ingestion under a\n * different HEAD or adapter version must dedup, not duplicate.\n *\n * `producer.model`/`provider`/`source_version` are excluded for the same\n * reason even though they *are* source-determined and stable per line. They\n * were added after events had already been captured without them, so folding\n * them into identity would give the very same transcript line a different id\n * before and after the upgrade — a rescan would duplicate every pre-upgrade\n * turn rather than dedup it. Identity answers \"which piece of source material\n * is this\"; the model that served it is provenance about that material, not\n * a second copy of it.\n */\nexport function eventId(event: EventDraft): string {\n  const identity = {\n    schema: SCHEMA_VERSION,\n    kind: event.kind,\n    occurred_at: event.occurred_at,\n    actor: { type: event.actor.type, id: event.actor.id },\n    source: event.producer.source,\n    session_id: event.producer.session_id,\n    conversation: event.conversation,\n    media_type: event.media_type,\n    content: event.content,\n    links: event.links,\n  };\n  return \"ev1-\" + sha256Hex(canonicalJson(identity));\n}\n\nexport function finalizeEvent(draft: EventDraft, now = new Date()): EvidenceEvent {\n  const event: EvidenceEvent = {\n    ...draft,\n    id: draft.id ?? eventId(draft),\n    schema: SCHEMA_VERSION,\n    recorded_at: draft.recorded_at ?? now.toISOString(),\n  };\n  const problems = validateEvent(event);\n  if (problems.length > 0) {\n    throw new Error(`invalid event: ${problems.join(\"; \")}`);\n  }\n  return event;\n}\n\nexport function validateEvent(event: EvidenceEvent): string[] {\n  const problems: string[] = [];\n  if (!event.id?.startsWith(\"ev1-\")) problems.push(\"id must start with ev1-\");\n  if (event.schema !== SCHEMA_VERSION) problems.push(`schema must be ${SCHEMA_VERSION}`);\n  if (!event.kind) problems.push(\"kind is required\");\n  if (!isIsoDate(event.occurred_at)) problems.push(\"occurred_at must be ISO 8601\");\n  if (!isIsoDate(event.recorded_at)) problems.push(\"recorded_at must be ISO 8601\");\n  if (!event.actor?.type) problems.push(\"actor.type is required\");\n  if (!event.producer?.tool) problems.push(\"producer.tool is required\");\n  if (event.content === undefined) problems.push(\"content is required\");\n  return problems;\n}\n\nfunction isIsoDate(s: unknown): boolean {\n  return typeof s === \"string\" && !Number.isNaN(Date.parse(s));\n}\n\n/** One event per line, canonical bytes — the note storage format. */\nexport function serializeEvent(event: EvidenceEvent): string {\n  return canonicalJson(event);\n}\n\nexport function parseEventLine(line: string): EvidenceEvent {\n  return JSON.parse(line) as EvidenceEvent;\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/src/schema.ts","numLines":307,"startLine":1,"totalLines":307},"type":"text"},"type":"user","userType":"external","uuid":"6b32f8c6-044f-4f8a-8662-9f138887a572","version":"2.1.232"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-14T01:57:41.214Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { spawnSync } from \"node:child_process\";\n2\timport { randomUUID } from \"node:crypto\";\n3\timport { normalizeTimestamp } from \"../timestamps.js\";\n4\timport { formatSize, transcriptSize } from \"../transcript.js\";\n5\timport { mkdir, writeFile } from \"node:fs/promises\";\n6\timport { homedir } from \"node:os\";\n7\timport { join } from \"node:path\";\n8\timport { bootstrapPrompt } from \"../bootstrap.js\";\n9\timport { binaryOnPath } from \"../launch.js\";\n10\timport { cliLabel, turnContent, type ConversationSummary, type TurnBlock } from \"../types.js\";\n11\timport { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \"./types.js\";\n12\t\n13\t/**\n14\t * Session writer validated against Claude Code 2.1.x (2026-07): resume looks\n15\t * up <uuid>.jsonl only inside the project directory encoded from the launch\n16\t * cwd; the conversation is reconstructed by walking parentUuid links backward\n17\t * from the last line, and timestamps are required on every line.\n18\t */\n19\tconst VALIDATED_VERSION_PREFIX = \"2.\";\n20\t\n21\tfunction claudeVersion(): string | null {\n22\t  const result = spawnSync(\"claude\", [\"--version\"], { encoding: \"utf8\" });\n23\t  if (result.status !== 0) return null;\n24\t  const match = result.stdout.match(/(\\d+\\.\\d+\\.\\d+)/);\n25\t  return match ? match[1]! : null;\n26\t}\n27\t\n28\t/** ~/.claude/projects key: every non-alphanumeric cwd character becomes \"-\". */\n29\texport function encodeProjectDir(cwd: string): string {\n30\t  return cwd.replace(/[^A-Za-z0-9]/g, \"-\");\n31\t}\n32\t\n33\tfunction projectsDir(): string {\n34\t  return join(process.env[\"CLAUDE_CONFIG_DIR\"] ?? join(homedir(), \".claude\"), \"projects\");\n35\t}\n36\t\n37\tinterface SessionLine {\n38\t  parentUuid: string | null;\n39\t  isSidechain: boolean;\n40\t  userType: string;\n41\t  entrypoint: string;\n42\t  cwd: string;\n43\t  sessionId: string;\n44\t  version: string;\n45\t  type: \"user\" | \"assistant\";\n46\t  message: Record<string, unknown>;\n47\t  uuid: string;\n48\t  timestamp: string;\n49\t}\n50\t\n51\t/** Cosmetic `ai-title` record — what the resume picker titles a session by. */\n52\tinterface TitleLine {\n53\t  type: \"ai-title\";\n54\t  aiTitle: string;\n55\t  sessionId: string;\n56\t}\n57\t\n58\texport type FabricatedLine = SessionLine | TitleLine;\n59\t\n60\t/** The `user`/`assistant` lines — i.e. everything the parentUuid walk sees. */\n61\texport function conversationLines(lines: FabricatedLine[]): SessionLine[] {\n62\t  return lines.filter((l): l is SessionLine => l.type === \"user\" || l.type === \"assistant\");\n63\t}\n64\t\n65\tinterface LineSpec {\n66\t  type: \"user\" | \"assistant\";\n67\t  content: unknown;\n68\t  timestamp: string;\n69\t  model?: string;\n70\t}\n71\t\n72\t/**\n73\t * Convert canonical blocks to Claude-native content blocks. Foreign tool\n74\t * calls keep their names (history is replayed as context, never re-executed);\n75\t * thinking blocks are folded to labeled text — their signatures can't be\n76\t * forged and must not be fabricated.\n77\t */\n78\tfunction convertBlocks(\n79\t  blocks: TurnBlock[],\n80\t  seenToolUseIds: Set<string>,\n81\t): unknown[] {\n82\t  const out: unknown[] = [];\n83\t  for (const block of blocks) {\n84\t    switch (block.type) {\n85\t      case \"text\":\n86\t        if (typeof block.text === \"string\" && block.text.trim()) {\n87\t          out.push({ type: \"text\", text: block.text });\n88\t        }\n89\t        break;\n90\t      case \"thinking\":\n91\t        if (block.text) out.push({ type: \"text\", text: `[visible thinking]\\n${String(block.text)}` });\n92\t        break;\n93\t      case \"tool_use\": {\n94\t        const id = typeof block.id === \"string\" ? block.id : `toolu_tb_${randomUUID().slice(0, 8)}`;\n95\t        seenToolUseIds.add(id);\n96\t        const input =\n97\t          block.input && typeof block.input === \"object\" ? block.input : { value: block.input ?? null };\n98\t        out.push({ type: \"tool_use\", id, name: block.name ?? \"ImportedTool\", input });\n99\t        break;\n100\t      }\n101\t      case \"tool_result\": {\n102\t        const id = typeof block.tool_use_id === \"string\" ? block.tool_use_id : null;\n103\t        if (id && seenToolUseIds.has(id)) {\n104\t          const content =\n105\t            typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n106\t          out.push({ type: \"tool_result\", tool_use_id: id, content });\n107\t        } else {\n108\t          // orphaned result — replay as labeled text rather than break pairing\n109\t          out.push({\n110\t            type: \"text\",\n111\t            text: `[tool result]\\n${typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\")}`,\n112\t          });\n113\t        }\n114\t        break;\n115\t      }\n116\t      default:\n117\t        out.push({ type: \"text\", text: JSON.stringify(block) });\n118\t    }\n119\t  }\n120\t  return out;\n121\t}\n122\t\n123\t/**\n124\t * Picker title for a bridged session.\n125\t *\n126\t * Verified by scripts/probe-picker.mjs: the picker titles a session by its\n127\t * `ai-title` line, falling back to the first user message when there is none.\n128\t * Fabricated sessions had no such line, so every bridged conversation showed\n129\t * up in the picker titled by turnbridge's own import notice — identical for\n130\t * every bridge, and describing the machinery rather than the conversation.\n131\t * Naming it after the first thing the human actually said is both more useful\n132\t * and closer to what the title would have been natively.\n133\t */\n134\tfunction pickerTitle(summary: ConversationSummary): string {\n135\t  const label = cliLabel(summary.source);\n136\t  for (const event of summary.events) {\n137\t    if (event.actor.type !== \"human\") continue;\n138\t    const content = turnContent(event);\n139\t    const text = content?.blocks\n140\t      .map((b) => (b.type === \"text\" && typeof b.text === \"string\" ? b.text : \"\"))\n141\t      .join(\" \")\n142\t      .trim();\n143\t    if (!text) continue;\n144\t    const oneLine = text.replace(/\\s+/g, \" \");\n145\t    const snippet = oneLine.length > 48 ? `${oneLine.slice(0, 47)}…` : oneLine;\n146\t    return `${snippet} (from ${label})`;\n147\t  }\n148\t  return `Imported from ${label}`;\n149\t}\n150\t\n151\texport function buildSessionLines(\n152\t  summary: ConversationSummary,\n153\t  sessionId: string,\n154\t  cwd: string,\n155\t  version: string,\n156\t  now: Date,\n157\t): FabricatedLine[] {\n158\t  const specs: LineSpec[] = [\n159\t    {\n160\t      type: \"user\",\n161\t      // Fabrication time, which is *newer* than every history line below it, so\n162\t      // the file steps backward exactly once at line 1. Verified deliberate, not\n163\t      // an oversight: probe-session-invariants.mjs resumed both this and a\n164\t      // backdated-monotonic variant with full history intact, so ordering is not\n165\t      // load-bearing for resume. Keeping `now` is the weakly better of two\n166\t      // safe options — if the picker sorts on line timestamps rather than file\n167\t      // mtime, backdating would bury a freshly bridged session under genuinely\n168\t      // old ones, and no reading of the evidence makes it better.\n169\t      timestamp: now.toISOString(),\n170\t      content: [\n171\t        {\n172\t          type: \"text\",\n173\t          text:\n174\t            `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n175\t            \"The history below is the literal visible transcript; hidden reasoning and provider-private \" +\n176\t            \"state were not transferred, and historical tool calls are context only.\",\n177\t        },\n178\t      ],\n179\t    },\n180\t  ];\n181\t\n182\t  const seenToolUseIds = new Set<string>();\n183\t  for (const event of summary.events) {\n184\t    const content = turnContent(event);\n185\t    if (!content) continue;\n186\t    const blocks = convertBlocks(content.blocks, seenToolUseIds);\n187\t    if (blocks.length === 0) continue;\n188\t    // tool results ride on user lines in Claude's format\n189\t    const type = event.actor.type === \"human\" || content.role === \"tool_result\" ? \"user\" : \"assistant\";\n190\t    const spec: LineSpec = {\n191\t      type,\n192\t      content: blocks,\n193\t      timestamp: normalizeTimestamp(event.occurred_at, now),\n194\t    };\n195\t    if (type === \"assistant\" && event.actor.type === \"agent\" && event.actor.id) {\n196\t      spec.model = event.actor.id;\n197\t    }\n198\t    specs.push(spec);\n199\t  }\n200\t\n201\t  const lines: SessionLine[] = [];\n202\t  let parentUuid: string | null = null;\n203\t  for (const spec of specs) {\n204\t    const uuid = randomUUID();\n205\t    const message: Record<string, unknown> =\n206\t      spec.type === \"assistant\"\n207\t        ? {\n208\t            // full envelope: defends against stricter validation in other versions\n209\t            model: spec.model ?? \"turnbridge-import\",\n210\t            id: `msg_tb_${uuid.slice(0, 8)}`,\n211\t            type: \"message\",\n212\t            role: \"assistant\",\n213\t            content: spec.content,\n214\t            stop_reason: \"end_turn\",\n215\t            stop_sequence: null,\n216\t            usage: { input_tokens: 0, output_tokens: 0 },\n217\t          }\n218\t        : { role: \"user\", content: spec.content };\n219\t    lines.push({\n220\t      parentUuid,\n221\t      isSidechain: false,\n222\t      userType: \"external\",\n223\t      entrypoint: \"cli\",\n224\t      cwd,\n225\t      sessionId,\n226\t      version,\n227\t      type: spec.type,\n228\t      message,\n229\t      uuid,\n230\t      timestamp: spec.timestamp,\n231\t    });\n232\t    parentUuid = uui