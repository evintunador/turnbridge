42\t  cwd: string;\n43\t  sessionId: string;\n44\t  version: string;\n45\t  type: \"user\" | \"assistant\";\n46\t  message: Record<string, unknown>;\n47\t  uuid: string;\n48\t  timestamp: string;\n49\t}\n50\t\n51\t/** Cosmetic `ai-title` record — what the resume picker titles a session by. */\n52\tinterface TitleLine {\n53\t  type: \"ai-title\";\n54\t  aiTitle: string;\n55\t  sessionId: string;\n56\t}\n57\t\n58\texport type FabricatedLine = SessionLine | TitleLine;\n59\t\n60\t/** The `user`/`assistant` lines — i.e. everything the parentUuid walk sees. */\n61\texport function conversationLines(lines: FabricatedLine[]): SessionLine[] {\n62\t  return lines.filter((l): l is SessionLine => l.type === \"user\" || l.type === \"assistant\");\n63\t}\n64\t\n65\tinterface LineSpec {\n66\t  type: \"user\" | \"assistant\";\n67\t  content: unknown;\n68\t  timestamp: string;\n69\t  model?: string;\n70\t}\n71\t\n72\t/**\n73\t * Convert canonical blocks to Claude-native content blocks. Foreign tool\n74\t * calls keep their names (history is replayed as context, never re-executed);\n75\t * thinking blocks are folded to labeled text — their signatures can't be\n76\t * forged and must not be fabricated.\n77\t */\n78\tfunction convertBlocks(\n79\t  blocks: TurnBlock[],\n80\t  seenToolUseIds: Set<string>,\n81\t): unknown[] {\n82\t  const out: unknown[] = [];\n83\t  for (const block of blocks) {\n84\t    switch (block.type) {\n85\t      case \"text\":\n86\t        if (typeof block.text === \"string\" && block.text.trim()) {\n87\t          out.push({ type: \"text\", text: block.text });\n88\t        }\n89\t        break;\n90\t      case \"thinking\":\n91\t        if (block.text) out.push({ type: \"text\", text: `[visible thinking]\\n${String(block.text)}` });\n92\t        break;\n93\t      case \"tool_use\": {\n94\t        const id = typeof block.id === \"string\" ? block.id : `toolu_tb_${randomUUID().slice(0, 8)}`;\n95\t        seenToolUseIds.add(id);\n96\t        const input =\n97\t          block.input && typeof block.input === \"object\" ? block.input : { value: block.input ?? null };\n98\t        out.push({ type: \"tool_use\", id, name: block.name ?? \"ImportedTool\", input });\n99\t        break;\n100\t      }\n101\t      case \"tool_result\": {\n102\t        const id = typeof block.tool_use_id === \"string\" ? block.tool_use_id : null;\n103\t        if (id && seenToolUseIds.has(id)) {\n104\t          const content =\n105\t            typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n106\t          out.push({ type: \"tool_result\", tool_use_id: id, content });\n107\t        } else {\n108\t          // orphaned result — replay as labeled text rather than break pairing\n109\t          out.push({\n110\t            type: \"text\",\n111\t            text: `[tool result]\\n${typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\")}`,\n112\t          });\n113\t        }\n114\t        break;\n115\t      }\n116\t      default:\n117\t        out.push({ type: \"text\", text: JSON.stringify(block) });\n118\t    }\n119\t  }\n120\t  return out;\n121\t}\n122\t\n123\t/**\n124\t * Picker title for a bridged session.\n125\t *\n126\t * Verified by scripts/probe-picker.mjs: the picker titles a session by its\n127\t * `ai-title` line, falling back to the first user message when there is none.\n128\t * Fabricated sessions had no such line, so every bridged conversation showed\n129\t * up in the picker titled by turnbridge's own import notice — identical for\n130\t * every bridge, and describing the machinery rather than the conversation.\n131\t * Naming it after the first thing the human actually said is both more useful\n132\t * and closer to what the title would have been natively.\n133\t */\n134\tfunction pickerTitle(summary: ConversationSummary): string {\n135\t  const label = cliLabel(summary.source);\n136\t  for (const event of summary.events) {\n137\t    if (event.actor.type !== \"human\") continue;\n138\t    const content = turnContent(event);\n139\t    const text = content?.blocks\n140\t      .map((b) => (b.type === \"text\" && typeof b.text === \"string\" ? b.text : \"\"))\n141\t      .join(\" \")\n142\t      .trim();\n143\t    if (!text) continue;\n144\t    const oneLine = text.replace(/\\s+/g, \" \");\n145\t    const snippet = oneLine.length > 48 ? `${oneLine.slice(0, 47)}…` : oneLine;\n146\t    return `${snippet} (from ${label})`;\n147\t  }\n148\t  return `Imported from ${label}`;\n149\t}\n150\t\n151\texport function buildSessionLines(\n152\t  summary: ConversationSummary,\n153\t  sessionId: string,\n154\t  cwd: string,\n155\t  version: string,\n156\t  now: Date,\n157\t): FabricatedLine[] {\n158\t  const specs: LineSpec[] = [\n159\t    {\n160\t      type: \"user\",\n161\t      // Fabrication time, which is *newer* than every history line below it, so\n162\t      // the file steps backward exactly once at line 1. Verified deliberate, not\n163\t      // an oversight: probe-session-invariants.mjs resumed both this and a\n164\t      // backdated-monotonic variant with full history intact, so ordering is not\n165\t      // load-bearing for resume. Keeping `now` is the weakly better of two\n166\t      // safe options — if the picker sorts on line timestamps rather than file\n167\t      // mtime, backdating would bury a freshly bridged session under genuinely\n168\t      // old ones, and no reading of the evidence makes it better.\n169\t      timestamp: now.toISOString(),\n170\t      content: [\n171\t        {\n172\t          type: \"text\",\n173\t          text:\n174\t            `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n175\t            \"The history below is the literal visible transcript; hidden reasoning and provider-private \" +\n176\t            \"state were not transferred, and historical tool calls are context only.\",\n177\t        },\n178\t      ],\n179\t    },\n180\t  ];\n181\t\n182\t  const seenToolUseIds = new Set<string>();\n183\t  for (const event of summary.events) {\n184\t    const content = turnContent(event);\n185\t    if (!content) continue;\n186\t    const blocks = convertBlocks(content.blocks, seenToolUseIds);\n187\t    if (blocks.length === 0) continue;\n188\t    // tool results ride on user lines in Claude's format\n189\t    const type = event.actor.type === \"human\" || content.role === \"tool_result\" ? \"user\" : \"assistant\";\n190\t    const spec: LineSpec = {\n191\t      type,\n192\t      content: blocks,\n193\t      timestamp: normalizeTimestamp(event.occurred_at, now),\n194\t    };\n195\t    if (type === \"assistant\" && event.actor.type === \"agent\" && event.actor.id) {\n196\t      spec.model = event.actor.id;\n197\t    }\n198\t    specs.push(spec);\n199\t  }\n200\t\n201\t  const lines: SessionLine[] = [];\n202\t  let parentUuid: string | null = null;\n203\t  for (const spec of specs) {\n204\t    const uuid = randomUUID();\n205\t    const message: Record<string, unknown> =\n206\t      spec.type === \"assistant\"\n207\t        ? {\n208\t            // full envelope: defends against stricter validation in other versions\n209\t            model: spec.model ?? \"turnbridge-import\",\n210\t            id: `msg_tb_${uuid.slice(0, 8)}`,\n211\t            type: \"message\",\n212\t            role: \"assistant\",\n213\t            content: spec.content,\n214\t            stop_reason: \"end_turn\",\n215\t            stop_sequence: null,\n216\t            usage: { input_tokens: 0, output_tokens: 0 },\n217\t          }\n218\t        : { role: \"user\", content: spec.content };\n219\t    lines.push({\n220\t      parentUuid,\n221\t      isSidechain: false,\n222\t      userType: \"external\",\n223\t      entrypoint: \"cli\",\n224\t      cwd,\n225\t      sessionId,\n226\t      version,\n227\t      type: spec.type,\n228\t      message,\n229\t      uuid,\n230\t      timestamp: spec.timestamp,\n231\t    });\n232\t    parentUuid = uuid;\n233\t  }\n234\t  // Trailing placement verified safe by probe-session-invariants.mjs: the\n235\t  // parentUuid walk starts at the last line but skips non-conversation types,\n236\t  // so a trailing ai-title does not truncate history.\n237\t  return [...lines, { type: \"ai-title\", aiTitle: pickerTitle(summary), sessionId }];\n238\t}\n239\t\n240\texport const claudeCodeTarget: TargetAdapter = {\n241\t  name: \"claude-code\",\n242\t  binary: \"claude\",\n243\t\n244\t  isInstalled() {\n245\t    return binaryOnPath(\"claude\");\n246\t  },\n247\t\n248\t  nativeResume(sessionId: string, cwd: string): LaunchPlan {\n249\t    return {\n250\t      command: \"claude\",\n251\t      args: [\"--resume\", sessionId],\n252\t      cwd,\n253\t      notes: [`resuming native Claude Code session ${sessionId}`],\n254\t    };\n255\t  },\n256\t\n257\t  // `opts.replayReasoning` doesn't apply here: only Codex issues opaque\n258\t  // reasoning ciphertext, and it can't be forged as a native Claude Code\n259\t  // reasoning item, so there is nothing for this target to replay.\n260\t  async fabricate(summary: ConversationSummary, cwd: string): Promise<LaunchPlan> {\n261\t    const version = claudeVersion();\n262\t    if (!version) {\n263\t      throw new FabricationUnsupportedError(\"could not determine claude version\", \"claude-code\");\n264\t    }\n265\t    const notes: string[] = [];\n266\t    if (!version.startsWith(VALIDATED_VERSION_PREFIX)) {\n267\t      notes.push(\n268\t        `claude ${version} has not been validated against the fabrication spec (pinned ${VALIDATED_VERSION_PREFIX}x); ` +\n269\t          \"rerun with --bootstrap if the resumed session misbehaves\",\n270\t      );\n271\t    }\n272\t\n273\t    const sessionId = randomUUID();\n274\t    // resume lookup is scoped to the project dir encoded from the launch cwd\n275\t    const dir = join(projectsDir(), encodeProjectDir(cwd));\n276\t    await mkdir(dir, { recursive: true });\n277\t    const path = join(dir, `${sessionId}.jsonl`);\n278\t    const lines = buildSessionLines(summary, sessionId, cwd, version, new Date());\n279\t    const body = lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\";\n280\t    await writeFile(path, body);\n281\t\n282\t    notes.push(\n283\t      `fabricated Claude Code session ${sessionId} from ${cliLabel(summary.source)} history (${summary.turnCount} turns)`,\n284\t      `session file: ${path} (${formatSize(transcriptSize(body))})`,\n285\t    );\n286\t    return {\n287\t      command: \"claude\",\n288\t      args: [\"--resume\", sessionId],\n289\t      cwd,\n290\t      notes,\n291\t      fabricatedConversationId: `claude-code:${sessionId}`,\n292\t    };\n293\t  },\n294\t\n295\t  bootstrap(summary: ConversationSummary, cwd: string, transcriptPath: string): LaunchPlan {\n296\t    return {\n297\t      command: \"claude\",\n298\t      args: [bootstrapPrompt(summary, transcriptPath)],\n299\t      cwd,\n300\t      notes: [\n301\t        `starting a NEW Claude Code session rehydrated from ${cliLabel(summary.source)} (bootstrap mode)`,\n302\t        `transcript: ${transcriptPath}`,\n303\t      ],\n304\t    };\n305\t  },\n306\t};\n307\t","tool_use_id":"toolu_01XU8CFQvT2CC2RLE6ALvcH4","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/turnbridge","head":"defab1d48ffb334ef077b543c74110f5a05efd71","repo":"git@github.com:evintunador/turnbridge.git"},"conversation":{"id":"claude-code:60ec7095-598e-476f-acb7-dd4ee0cab6f1","seq":55},"id":"ev1-2d3f3854538378af8545b31cbd81b9413846b651c219afd4c090cf8fa570e9fe","kind":"conversation_turn","occurred_at":"2026-08-12T01:20:47.248Z","producer":{"session_id":"60ec7095-598e-476f-acb7-dd4ee0cab6f1","source":"claude-code","source_version":"2.1.228","tool":"cledger","version":"0.20.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/turnbridge","entrypoint":"cli","gitBranch":"main","isSidechain":false,"message":{"content":[{"content":"1\timport { spawnSync 