meaningful without knowing whose subagent it was.\n161\t   *\n162\t   * Part of event identity, like the rest of `ConversationRef`: it is stated\n163\t   * by the source, stable across rescans, and distinguishes a subagent's turn\n164\t   * from an identical-looking parent turn.\n165\t   */\n166\t  parent?: string;\n167\t}\n168\t\n169\texport interface EventLink {\n170\t  /** e.g. \"redacts\", \"supersedes\", \"annotates\", \"replies_to\" */\n171\t  rel: string;\n172\t  /** Target event id. */\n173\t  target: string;\n174\t}\n175\t\n176\texport interface EvidenceEvent {\n177\t  /** \"ev1-\" + sha256 of the identity subset (see eventId). */\n178\t  id: string;\n179\t  schema: typeof SCHEMA_VERSION;\n180\t  kind: string;\n181\t  /** When the content happened, ISO 8601 UTC (from the source when known). */\n182\t  occurred_at: string;\n183\t  /** When this event was appended to the ledger. Not part of identity. */\n184\t  recorded_at: string;\n185\t  actor: Actor;\n186\t  producer: Producer;\n187\t  /** IANA media type of `content`; defaults to application/json. */\n188\t  media_type?: string;\n189\t  /** The visible content itself, stored inline and never reinterpreted. */\n190\t  content: unknown;\n191\t  /** Repository context at capture time. Not part of identity. */\n192\t  context?: RepoContext;\n193\t  conversation?: ConversationRef;\n194\t  links?: EventLink[];\n195\t  /**\n196\t   * Opaque source-native payload for lossless export, e.g. the original\n197\t   * transcript line(s). Versioned by `format`. Not part of identity.\n198\t   */\n199\t  raw?: { format: string; data: unknown };\n200\t  /**\n201\t   * What the ledger could resolve, at capture time, of pointers the source\n202\t   * line only names. A Claude Code `file-history-snapshot` says a file's\n203\t   * bytes live at `<backup file>` under a machine-local cache directory; this\n204\t   * is where the sha256 and size the ledger read from that file go, so the\n205\t   * record can be verified later even though the cache itself is prunable and\n206\t   * unshareable.\n207\t   *\n208\t   * Excluded from the identity subset, and that exclusion is the point: the\n209\t   * same transcript line resolves differently on a machine without the cache,\n210\t   * or after the cache is pruned, and identity must answer \"which piece of\n211\t   * source material is this\", not \"what could this machine see at the time\".\n212\t   * Folding it in would make a rescan after a prune duplicate every snapshot\n213\t   * rather than dedup it.\n214\t   *\n215\t   * Holds derived facts about local state — digests, sizes, counts — never\n216\t   * file bodies: the redaction stack walks `content` and `raw.data`, not this,\n217\t   * so anything secret-bearing put here would bypass it.\n218\t   */\n219\t  resolved?: Record<string, unknown>;\n220\t  /**\n221\t   * Capture-time redaction records (rule id, ruleset version, fingerprint,\n222\t   * location path), present when the capture-tier ruleset rewrote part of\n223\t   * `content`/`raw.data` before this event was finalized. Deliberately\n224\t   * excluded from the identity subset: the rewritten `content` already\n225\t   * determines `id`, so including this here would double-count the same\n226\t   * fact and would churn ids on ruleset upgrades even when the visible\n227\t   * content is unchanged.\n228\t   */\n229\t  redactions?: RedactionRecord[];\n230\t}\n231\t\n232\t/** Fields an adapter supplies; id/schema/recorded_at are filled at append. */\n233\texport type EventDraft = Omit<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\"> &\n234\t  Partial<Pick<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\">>;\n235\t\n236\t/**\n237\t * Event identity is derived from the durable, source-determined subset so\n238\t * that re-scanning the same source material always yields the same id\n239\t * (idempotent capture). Volatile provenance — recorded_at, context, raw,\n240\t * producer.version/tool — is deliberately excluded: a re-ingestion under a\n241\t * different HEAD or adapter version must dedup, not duplicate.\n242\t *\n243\t * `producer.model`/`provider`/`source_version` are excluded for the same\n244\t * reason even though they *are* source-determined and stable per line. They\n245\t * were added after events had already been captured without them, so folding\n246\t * them into identity would give the very same transcript line a different id\n247\t * before and after the upgrade — a rescan would duplicate every pre-upgrade\n248\t * turn rather than dedup it. Identity answers \"which piece of source material\n249\t * is this\"; the model that served it is provenance about that material, not\n250\t * a second copy of it.\n251\t */\n252\texport function eventId(event: EventDraft): string {\n253\t  const identity = {\n254\t    schema: SCHEMA_VERSION,\n255\t    kind: event.kind,\n256\t    occurred_at: event.occurred_at,\n257\t    actor: { type: event.actor.type, id: event.actor.id },\n258\t    source: event.producer.source,\n259\t    session_id: event.producer.session_id,\n260\t    conversation: event.conversation,\n261\t    media_type: event.media_type,\n262\t    content: event.content,\n263\t    links: event.links,\n264\t  };\n265\t  return \"ev1-\" + sha256Hex(canonicalJson(identity));\n266\t}\n267\t\n268\texport function finalizeEvent(draft: EventDraft, now = new Date()): EvidenceEvent {\n269\t  const event: EvidenceEvent = {\n270\t    ...draft,\n271\t    id: draft.id ?? eventId(draft),\n272\t    schema: SCHEMA_VERSION,\n273\t    recorded_at: draft.recorded_at ?? now.toISOString(),\n274\t  };\n275\t  const problems = validateEvent(event);\n276\t  if (problems.length > 0) {\n277\t    throw new Error(`invalid event: ${problems.join(\"; \")}`);\n278\t  }\n279\t  return event;\n280\t}\n281\t\n282\texport function validateEvent(event: EvidenceEvent): string[] {\n283\t  const problems: string[] = [];\n284\t  if (!event.id?.startsWith(\"ev1-\")) problems.push(\"id must start with ev1-\");\n285\t  if