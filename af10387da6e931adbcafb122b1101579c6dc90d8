tputs.report }}\n        with:\n          script: |\n            const title = \"Adapter drift: target CLI released outside validated version range\";\n            const open = await github.rest.issues.listForRepo({\n              ...context.repo, state: \"open\", labels: \"adapter-drift\",\n            });\n            const body = process.env.REPORT +\n              \"\\n\\n_Automated by .github/workflows/adapter-drift.yml — updates daily while drift persists._\";\n            if (open.data.length > 0) {\n              await github.rest.issues.update({\n                ...context.repo, issue_number: open.data[0].number, body,\n              });\n            } else {\n              await github.rest.issues.create({\n                ...context.repo, title, body, labels: [\"adapter-drift\"],\n              });\n            }\n\n  close-issue:\n    needs: check\n    if: needs.check.outputs.drift == 'false'\n    runs-on: ubuntu-latest\n    permissions:\n      issues: write\n    steps:\n      - uses: actions/github-script@v7\n        with:\n          script: |\n            const open = await github.rest.issues.listForRepo({\n              ...context.repo, state: \"open\", labels: \"adapter-drift\",\n            });\n            for (const issue of open.data) {\n              await github.rest.issues.createComment({\n                ...context.repo, issue_number: issue.number,\n                body: \"Every target CLI's latest release is back inside the adapters' validated version prefixes. Closing automatically.\",\n              });\n              await github.rest.issues.update({\n                ...context.repo, issue_number: issue.number, state: \"closed\",\n              });\n            }\n","file_path":"/Users/evintunador/repos/evintunador/turnbridge/.claude/worktrees/codex-0146-revalidation/.github/workflows/adapter-drift.yml"},"name":"Write","type":"tool_use"}],"role":"assistant"},"context":{"branch":"worktree-codex-0146-revalidation","cwd":"/Users/evintunador/