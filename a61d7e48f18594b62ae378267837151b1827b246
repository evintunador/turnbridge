p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}-${p(d.getMinutes())}-${p(d.getSeconds())}`;\n38\t  return { datePath, stamp };\n39\t}\n40\t\n41\t/**\n42\t * Fold any block into plain text. Only input_text/output_text message blocks\n43\t * are validated to replay safely in Codex, so foreign tool calls become\n44\t * labeled text rather than fabricated function_call records.\n45\t */\n46\tfunction foldBlock(block: TurnBlock): string {\n47\t  switch (block.type) {\n48\t    case \"text\":\n49\t      return typeof block.text === \"string\" ? block.text : \"\";\n50\t    case \"thinking\":\n51\t      return block.text ? `[visible thinking]\\n${String(block.text)}` : \"\";\n52\t    case \"tool_use\":\n53\t      return `[used tool: ${block.name ?? \"unknown\"}]\\ninput: ${JSON.stringify(block.input ?? {})}`;\n54\t    case \"tool_result\": {\n55\t      const body =\n56\t        typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n57\t      return `[tool result]\\n${body}`;\n58\t    }\n59\t    default:\n60\t      return JSON.stringify(block);\n61\t  }\n62\t}\n63\t\n64\tinterface RolloutLine {\n65\t  timestamp: string;\n66\t  type: string;\n67\t  payload: Record<string, unknown>;\n68\t}\n69\t\n70\tfunction messageLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n71\t  const blockType = role === \"assistant\" ? \"output_text\" : \"input_text\";\n72\t  return {\n73\t    timestamp,\n74\t    type: \"response_item\",\n75\t    payload: { type: \"message\", role, content: [{ type: blockType, text }] },\n76\t  };\n77\t}\n78\t\n79\t/**\n80\t * TUI scrollback renders from event_msg records, not response_items; without\n81\t * these the resumed session looks empty even though the model sees history.\n82\t */\n83\tfunction displayLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n84\t  const payload =\n85\t    role === \"user\"\n86\t      ? { type: \"user_message\", me