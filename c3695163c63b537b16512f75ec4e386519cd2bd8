stConversations(repo, {\n159\t      all: flags.all ?? false,\n160\t      user: identity.email ?? undefined,\n161\t      anyCommit: flags.anyCommit ?? false,\n162\t    });\n163\t    return [convs, await readLineage(repo, flags.anyCommit ?? false)] as const;\n164\t  });\n165\t\n166\t  if (conversations.length === 0) {\n167\t    process.stderr.write(\n168\t      \"turnbridge: no captured conversations for this repo state.\\n\" +\n169\t        \"  - capture runs via conversation-ledger hooks: `cledger install all`\\n\" +\n170\t        \"  - `--any-commit` lists conversations from other branches/commits\\n\" +\n171\t        \"  - `--all` includes collaborators' conversations\\n\",\n172\t    );\n173\t    return 1;\n174\t  }\n175\t\n176\t  if (flags.listOnly) {\n177\t    conversations.forEach((c, i) =>\n178\t      process.stdout.write(renderConversationRow(c, i, identity.email, lineage) + \"\\n\"),\n179\t    );\n180\t    return 0;\n181\t  }\n182\t\n183\t  const summary = await pickFromList(\n184\t    conversations,\n185\t    (c, i) => renderConversationRow(c, i, identity.email, lineage),\n186\t    \"Resume which conversation?\",\n187\t  );\n188\t  if (!summary) return 0;\n189\t\n190\t  const target = await chooseTarget(flags);\n191\t  if (!target) return 1;\n192\t  if (!(await target.isInstalled())) {\n193\t    process.stderr.write(`turnbridge: ${target.binary} is not on PATH\\n`);\n194\t    return 1;\n195\t  }\n196\t\n197\t  const plan = await buildPlan(repo, target, summary, cwd, flags.bootstrap ?? false, lineage);\n198\t  return runLaunchPlan(plan);\n199\t}\n200\t","type":"input_text"}],"type":"function_call_output"},"timestamp":"2026-07-24T06:33:17.213Z","type":"response_item"},"format":"codex-rollout-jsonl/2"},"recorded_at":"2026-09-24T01:39:56.413Z","schema":"annals/v1","stream":{"id":"codex:9d261764-bb80-489b-a27a-efbf8948150d","seq":137}}
