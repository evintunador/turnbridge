{"content":{"blocks":[{"content":[{"text":"1\timport { spawnSync } from \"node:child_process\";\n2\timport { randomUUID } from \"node:crypto\";\n3\timport { mkdir, writeFile } from \"node:fs/promises\";\n4\timport { homedir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\timport { bootstrapPrompt } from \"../bootstrap.js\";\n7\timport { binaryOnPath } from \"../launch.js\";\n8\timport { cliLabel, turnContent, type ConversationSummary, type TurnBlock } from \"../types.js\";\n9\timport { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \"./types.js\";\n10\t\n11\t/**\n12\t * Rollout writer validated against codex-cli 0.144.x and 0.145.x (2026-07):\n13\t * resume-by-id scans ~/.codex/sessions for a rollout file whose name and\n14\t * session_meta id match; plain `message` response_items are the replayed\n15\t * conversation state. 0.145.0 revalidated 2026-07-21 via the interactive\n16\t * smoke test plus a headless `codex exec resume` marker-recall probe\n17\t * (scripts/probe-codex-content.mjs).\n18\t */\n19\tconst VALIDATED_VERSION_PREFIXES = [\"0.144.\", \"0.145.\"];\n20\t\n21\tfunction codexVersion(): string | null {\n22\t  const result = spawnSync(\"codex\", [\"--version\"], { encoding: \"utf8\" });\n23\t  if (result.status !== 0) return null;\n24\t  const match = result.stdout.match(/(\\d+\\.\\d+\\.\\d+)/);\n25\t  return match ? match[1]! : null;\n26\t}\n27\t\n28\tfunction sessionsDir(): string {\n29\t  const home = process.env[\"CODEX_HOME\"] ?? join(homedir(), \".codex\");\n30\t  return join(home, \"sessions\");\n31\t}\n32\t\n33\t/** Local-time filename stamp: YYYY-MM-DDTHH-MM-SS. */\n34\tfunction localStamp(d: Date): { datePath: string; stamp: string } {\n35\t  const p = (n: number, w = 2) => String(n).padStart(w, \"0\");\n36\t  const datePath = join(String(d.getFullYear()), p(d.getMonth() + 1), p(d.getDate()));\n37\t  const stamp = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}-${p(d.getMinutes())}-${p(d.getSeconds())}`;\n38\t  return { datePath, stamp };\n39\t}\n40\t\n41\t/**\n42\t * Fold any block into plain text. Only input_text/output_text message blocks\n43\t * are validated to replay safely in Codex, so foreign tool calls become\n44\t * labeled text rather than fabricated function_call records.\n45\t */\n46\tfunction foldBlock(block: TurnBlock): string {\n47\t  switch (block.type) {\n48\t    case \"text\":\n49\t      return typeof block.text === \"string\" ? block.text : \"\";\n50\t    case \"thinking\":\n51\t      return block.text ? `[visible thinking]\\n${String(block.text)}` : \"\";\n52\t    case \"tool_use\":\n53\t      return `[used tool: ${block.name ?? \"unknown\"}]\\ninput: ${JSON.stringify(block.input ?? {})}`;\n54\t    case \"tool_result\": {\n55\t      const body =\n56\t        typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n57\t      return `[tool result]\\n${body}`;\n58\t    }\n59\t    default:\n60\t      return JSON.stringify(block);\n61\t  }\n62\t}\n63\t\n64\tinterface RolloutLine {\n65\t  timestamp: string;\n66\t  type: string;\n67\t  payload: Record<string, unknown>;\n68\t}\n69\t\n70\tfunction messageLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n71\t  const blockType = role === \"assistant\" ? \"output_text\" : \"input_text\";\n72\t  return {\n73\t    timestamp,\n74\t    type: \"response_item\",\n75\t    payload: { type: \"message\", role, content: [{ type: blockType, text }] },\n76\t  };\n77\t}\n78\t\n79\t/**\n80\t * TUI scrollback renders from event_msg records, not response_items; without\n81\t * these the resumed session looks empty even though the model sees history.\n82\t */\n83\tfunction displayLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n84\t  const payload =\n85\t    role === \"user\"\n86\t      ? { type: \"user_message\", message: text, images: [], local_images: [], text_elements: [] }\n87\t      : { type: \"agent_message\", message: text, phase: \"final_answer\", memory_citation: null };\n88\t  return { timestamp, type: \"event_msg\", payload };\n89\t}\n90\t\n91\t/** A conversation turn as both the model-context record and its display twin. */\n92\tfunction turnLines(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine[] {\n93\t  return role === \"user\"\n94\t    ? [displayLine(timestamp, role, text), messageLine(timestamp, role, text)]\n95\t    : [messageLine(timestamp, role, text), displayLine(timestamp, role, text)];\n96\t}\n97\t\n98\texport function buildRolloutLines(\n99\t  summary: ConversationSummary,\n100\t  sessionId: string,\n101\t  cwd: string,\n102\t  cliVersion: string,\n103\t  now: Date,\n104\t): RolloutLine[] {\n105\t  const nowIso = now.toISOString();\n106\t  const lines: RolloutLine[] = [\n107\t    {\n108\t      timestamp: nowIso,\n109\t      type: \"session_meta\",\n110\t      payload: {\n111\t        session_id: sessionId,\n112\t        id: sessionId,\n113\t        timestamp: nowIso,\n114\t        cwd,\n115\t        originator: \"codex-tui\",\n116\t        cli_version: cliVersion,\n117\t        source: \"cli\",\n118\t        thread_source: \"user\",\n119\t        model_provider: \"openai\",\n120\t        history_mode: \"legacy\",\n121\t      },\n122\t    },\n123\t    ...turnLines(\n124\t      nowIso,\n125\t      \"user\",\n126\t      `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n127\t        \"The history below is the literal visible transcript; hidden reasoning and provider-private \" +\n128\t        \"state were not transferred, and past tool calls are shown as labeled text, not replayable calls.\",\n129\t    ),\n130\t  ];\n131\t\n132\t  for (const event of summary.events) {\n133\t    const content = turnContent(event);\n134\t    if (!content) continue;\n135\t    const text = content.blocks.map(foldBlock).filter((t) => t.trim()).join(\"\\n\\n\");\n136\t    if (!text) continue;\n137\t    const role = event.actor.type === \"human\" ? \"user\" : \"assistant\";\n138\t    lines.push(...turnLines(event.occurred_at, role, text));\n139\t  }\n140\t  return lines;\n141\t}\n142\t\n143\texport const codexTarget: TargetAdapter = {\n144\t  name: \"codex\",\n145\t  binary: \"codex\",\n146\t\n147\t  isInstalled() {\n148\t    return binaryOnPath(\"codex\");\n149\t  },\n150\t\n151\t  nativeResume(sessionId: string, cwd: string): LaunchPlan {\n152\t    return {\n153\t      command: \"codex\",\n154\t      args: [\"resume\", sessionId],\n155\t      cwd,\n156\t      notes: [`resuming native Codex session ${sessionId}`],\n157\t    };\n158\t  },\n159\t\n160\t  async fabricate(summary: ConversationSummary, cwd: string): Promise<LaunchPlan> {\n161\t    const version = codexVersion();\n162\t    if (!version) {\n163\t      throw new FabricationUnsupportedError(\"could not determine codex version\", \"codex\");\n164\t    }\n165\t    const notes: string[] = [];\n166\t    if (!VALIDATED_VERSION_PREFIXES.some((p) => version.startsWith(p))) {\n167\t      notes.push(\n168\t        `codex ${version} has not been validated against the fabrication spec (validated: ${VALIDATED_VERSION_PREFIXES.map((p) => `${p}x`).join(\", \")}); ` +\n169\t          \"rerun with --bootstrap if the resumed session misbehaves\",\n170\t      );\n171\t    }\n172\t\n173\t    const sessionId = randomUUID();\n174\t    const now = new Date();\n175\t    const { datePath, stamp } = localStamp(now);\n176\t    const dir = join(sessionsDir(), datePath);\n177\t    await mkdir(dir, { recursive: true });\n178\t    const path = join(dir, `rollout-${stamp}-${sessionId}.jsonl`);\n179\t    const lines = buildRolloutLines(summary, sessionId, cwd, version, now);\n180\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n181\t\n182\t    notes.push(\n183\t      `fabricated Codex session ${sessionId} from ${cliLabel(summary.source)} history (${summary.turnCount}