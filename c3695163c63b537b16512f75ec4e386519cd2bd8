{"content":{"blocks":[{"content":[{"text":"1\timport { readEvents, sortEvents, type EvidenceEvent, type RepoInfo } from \"conversation-ledger\";\n2\timport { turnContent, type ConversationSummary } from \"./types.js\";\n3\t\n4\texport interface ListOptions {\n5\t  /** Include conversations from all authors, not just `user` / unowned. */\n6\t  all?: boolean;\n7\t  /** The current user's identity (git email) for ownership filtering. */\n8\t  user?: string | undefined;\n9\t  /** List conversations from all anchors, not just those reachable from HEAD. */\n10\t  anyCommit?: boolean;\n11\t}\n12\t\n13\t/** Human-typed text, as opposed to CLI-injected wrappers like <command-name>. */\n14\tfunction meaningfulText(text: string): string | null {\n15\t  const t = text.trim();\n16\t  if (!t || t.startsWith(\"<\")) return null;\n17\t  return t;\n18\t}\n19\t\n20\tfunction deriveTitle(events: EvidenceEvent[]): string {\n21\t  for (const event of events) {\n22\t    if (event.actor.type !== \"human\") continue;\n23\t    const content = turnContent(event);\n24\t    if (!content || content.role !== \"user\") continue;\n25\t    for (const block of content.blocks) {\n26\t      if (block.type !== \"text\" || typeof block.text !== \"string\") continue;\n27\t      const t = meaningfulText(block.text);\n28\t      if (!t) continue;\n29\t      const oneLine = t.replace(/\\s+/g, \" \");\n30\t      return oneLine.length > 80 ? oneLine.slice(0, 77) + \"...\" : oneLine;\n31\t    }\n32\t  }\n33\t  return \"(no visible user message)\";\n34\t}\n35\t\n36\texport async function listConversations(\n37\t  repo: RepoInfo,\n38\t  opts: ListOptions = {},\n39\t): Promise<ConversationSummary[]> {\n40\t  const events = await readEvents(repo, {\n41\t    kind: \"conversation_turn\",\n42\t    ...(opts.anyCommit ? {} : { reachableFrom: \"HEAD\" }),\n43\t  });\n44\t\n45\t  const groups = new Map<string, EvidenceEvent[]>();\n46\t  for (const event of events) {\n47\t    if (!event.conversation?.id) continue;\n48\t    const group = groups.get(event.conversation.id);\n49\t    if (group) group.push(event);\n50\t    else groups.set(event.conversation.id, [event]);\n51\t  }\n52\t\n53\t  const summaries: ConversationSummary[] = [];\n54\t  for (const [id, group] of groups) {\n55\t    const sorted = sortEvents(group);\n56\t    const owners = new Set<string>();\n57\t    const ownerDisplays = new Set<string>();\n58\t    for (const event of sorted) {\n59\t      if (event.actor.type === \"human\") {\n60\t        if (event.actor.id) owners.add(event.actor.id);\n61\t        if (event.actor.display) ownerDisplays.add(event.actor.display);\n62\t      }\n63\t    }\n64\t    const first = sorted[0]!;\n65\t    const last = sorted[sorted.length - 1]!;\n66\t    const source = first.producer.source ?? id.split(\":\")[0] ?? \"unknown\";\n67\t    const sessionId = first.producer.session_id ?? id.split(\":\").slice(1).join(\":\");\n68\t    summaries.push({\n69\t      id,\n70\t      source,\n71\t      sessionId,\n72\t      title: deriveTitle(sorted),\n73\t      firstActivity: first.occurred_at,\n74\t      lastActivity: last.occurred_at,\n75\t      turnCount: sorted.length,\n76\t      owners: [...owners],\n77\t      ownerDisplays: [...ownerDisplays],\n78\t      events: sorted,\n79\t    });\n80\t  }\n81\t\n82\t  const visible = summaries.filter((s) => {\n83\t    if (opts.all) return true;\n84\t    // Unowned conversations predate identity stamping; keep them visible.\n85\t    if (s.owners.length === 0) return true;\n86\t    return opts.user ? s.owners.includes(opts.user) : true;\n87\t  });\n88\t\n89\t  visible.sort((a, b) => (a.lastActivity < b.lastActivity ? 1 : -1));\n90\t  return visible;\n91\t}\n92\t","type":"input_text"}],"tool_use_id":"toolu_01JYm1huKfxerWrdDh1ADoUK","type":"tool_result"}],"role":"tool_result"},"context":{"branch":"annals-cledger","cwd":"/Users/evintunador/repos/evintunador/turnbridge","head":"c3695163c63b537b16512f75ec4e386519cd2bd8","repo":"git@github.com:evintunador/turnbridge.git