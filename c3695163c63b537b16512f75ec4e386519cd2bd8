{"content":{"blocks":[{"content":[{"text":"1\timport { findRepo, gitUserIdentity, type RepoInfo } from \"conversation-ledger\";\n2\timport { writeBootstrapTranscript } from \"./bootstrap.js\";\n3\timport { loadConfig, saveConfig } from \"./config.js\";\n4\timport { listConversations } from \"./conversations.js\";\n5\timport { recordContinuation, readLineage, type Lineage } from \"./lineage.js\";\n6\timport { runLaunchPlan } from \"./launch.js\";\n7\timport { withLedgerNotices } from \"./ledger-io.js\";\n8\timport { confirm, pickFromList } from \"./picker.js\";\n9\timport { installedTargets, targetFor } from \"./targets/index.js\";\n10\timport { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \"./targets/types.js\";\n11\timport { cliLabel, type CliName, type ConversationSummary } from \"./types.js\";\n12\timport { turnbridgeVersion } from \"./version.js\";\n13\t\n14\texport interface ResumeFlags {\n15\t  target?: CliName | undefined;\n16\t  all?: boolean;\n17\t  anyCommit?: boolean;\n18\t  bootstrap?: boolean;\n19\t  listOnly?: boolean;\n20\t}\n21\t\n22\tfunction relativeTime(iso: string): string {\n23\t  const then = Date.parse(iso);\n24\t  if (Number.isNaN(then)) return iso;\n25\t  const mins = Math.round((Date.now() - then) / 60000);\n26\t  if (mins < 1) return \"just now\";\n27\t  if (mins < 60) return `${mins}m ago`;\n28\t  const hours = Math.round(mins / 60);\n29\t  if (hours < 48) return `${hours}h ago`;\n30\t  return `${Math.round(hours / 24)}d ago`;\n31\t}\n32\t\n33\t/** Lineage annotation for a row: where it came from / where it was bridged. */\n34\tfunction lineageTag(summary: ConversationSummary, lineage: Lineage | undefined): string | null {\n35\t  if (!lineage) return null;\n36\t  const parent = lineage.parentOf.get(summary.id);\n37\t  if (parent) return `↳ continued from ${cliLabel(parent.source.split(\":\")[0] ?? \"\")}`;\n38\t  const children = lineage.childrenOf.get(summary.id);\n39\t  if (children && children.length > 0) {\n40\t    const latest = children.reduce((a, b) => (a.occurredAt > b.occurredAt ? a : b));\n41\t    return `→ bridged to ${cliLabel(latest.targetCli)} ${relativeTime(latest.occurredAt)}`;\n42\t  }\n43\t  return null;\n44\t}\n45\t\n46\texport function renderConversationRow(\n47\t  summary: ConversationSummary,\n48\t  index: number,\n49\t  selfEmail: string | null,\n50\t  lineage?: Lineage,\n51\t): string {\n52\t  const owner =\n53\t    summary.owners.length === 0\n54\t      ? \"author unknown\"\n55\t      : summary.owners.every((o) => o === selfEmail)\n56\t        ? null\n57\t        : summary.ownerDisplays[0] ?? summary.owners[0]!;\n58\t  const parts = [\n59\t    `[${index + 1}]`,\n60\t    cliLabel(summary.source).padEnd(11),\n61\t    relativeTime(summary.lastActivity).padStart(8),\n62\t    `${summary.turnCount} turns`.padStart(9),\n63\t  ];\n64\t  if (owner) parts.push(`by ${owner}`);\n65\t  const tag = lineageTag(summary, lineage);\n66\t  if (tag) parts.push(tag);\n67\t  parts.push(`· ${summary.title}`);\n68\t  return parts.join(\"  \");\n69\t}\n70\t\n71\tasync function chooseTarget(flags: ResumeFlags): Promise<TargetAdapter | null> {\n72\t  if (flags.target) return targetFor(flags.target);\n73\t  const config = await loadConfig();\n74\t  if (config.defaultTarget) return targetFor(config.defaultTarget);\n75\t\n76\t  const installed = await installedTargets();\n77\t  if (installed.length === 0) {\n78\t    process.stderr.write(\"turnbridge: no supported CLI found on PATH (claude, codex)\\n\");\n79\t    return null;\n80\t  }\n81\t  if (installed.length === 1) return installed[0]!;\n82\t\n83\t  const choice = await pickFromList(\n84\t    installed,\n85\t    (t, i) => `[${i + 1}] ${cliLabel(t.name)}`,\n86\t    \"Resume in which CLI?\",\n87\t  );\n88\t  if (!choice) return null;\n89\t  if (await confirm(`Make ${cliLabel(choice.name)} your default target?`)) {\n90\t    await saveConfig({ ...(await loadConfig()), defaultTarget: choice.name });\n91\t    process.stderr.write(