\n48\t\n49\tinterface LineSpec {\n50\t  type: \"user\" | \"assistant\";\n51\t  content: unknown;\n52\t  timestamp: string;\n53\t  model?: string;\n54\t}\n55\t\n56\t/**\n57\t * Convert canonical blocks to Claude-native content blocks. Foreign tool\n58\t * calls keep their names (history is replayed as context, never re-executed);\n59\t * thinking blocks are folded to labeled text — their signatures can't be\n60\t * forged and must not be fabricated.\n61\t */\n62\tfunction convertBlocks(\n63\t  blocks: TurnBlock[],\n64\t  seenToolUseIds: Set<string>,\n65\t): unknown[] {\n66\t  const out: unknown[] = [];\n67\t  for (const block of blocks) {\n68\t    switch (block.type) {\n69\t      case \"text\":\n70\t        if (typeof block.text === \"string\" && block.text.trim()) {\n71\t          out.push({ type: \"text\", text: block.text });\n72\t        }\n73\t        break;\n74\t      case \"thinking\":\n75\t        if (block.text) out.push({ type: \"text\", text: `[visible thinking]\\n${String(block.text)}` });\n76\t        break;\n77\t      case \"tool_use\": {\n78\t        const id = typeof block.id === \"string\" ? block.id : `toolu_tb_${randomUUID().slice(0, 8)}`;\n79\t        seenToolUseIds.add(id);\n80\t        const input =\n81\t          block.input && typeof block.input === \"object\" ? block.input : { value: block.input ?? null };\n82\t        out.push({ type: \"tool_use\", id, name: block.name ?? \"ImportedTool\", input });\n83\t        break;\n84\t      }\n85\t      case \"tool_result\": {\n86\t        const id = typeof block.tool_use_id === \"string\" ? block.tool_use_id : null;\n87\t        if (id && seenToolUseIds.has(id)) {\n88\t          const content =\n89\t            typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n90\t          out.push({ type: \"tool_result\", tool_use_id: id, content });\n91\t        } else {\n92\t          // orphaned result — replay as labeled text rather than break pairing\n93\t          out.push({\n94\t            type: \"text\",\n95\t            text: `[tool result]\\n${typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\")}`,\n96\t          });\n97\t        }\n98\t        break;\n99\t      }\n100\t      default:\n101\t        out.push({ type: \"text\", text: JSON.stringify(block) });\n102\t    }\n103\t  }\n104\t  return out;\n105\t}\n106\t\n107\texport function buildSessionLines(\n108\t  summary: ConversationSummary,\n109\t  sessionId: string,\n110\t  cwd: string,\n111\t  version: string,\n112\t  now: Date,\n113\t): SessionLine[] {\n114\t  const specs: LineSpec[] = [\n115\t    {\n116\t      type: \"user\",\n117\t      timestamp: now.toISOString(),\n118\t      content: [\n119\t        {\n120\t          type: \"text\",\n121\t          text:\n122\t            `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n123\t            \"The history below is the literal visible transcript; hidden reasoning and provider-private \" +\n124\t            \"state were not transferred, and historical tool calls are context only.\",\n125\t        },\n126\t      ],\n127\t    },\n128\t  ];\n129\t\n130\t  const seenToolUseIds = new Set<string>();\n131\t  for (const event of summary.events) {\n132\t    const content = turnContent(event);\n133\t    if (!content) continue;\n134\t    const blocks = convertBlocks(content.blocks, seenToolUseIds);\n135\t    if (blocks.length === 0) continue;\n136\t    // tool results ride on user lines in Claude's format\n137\t    const type = event.actor.type === \"human\" || content.role === \"tool_result\" ? \"user\" : \"assistant\";\n138\t    const spec: LineSpec = { type, content: blocks, timestamp: event.occurred_at };\n139\t    if (type === \"assistant\" && event.actor.type === \"agent\" && event.actor.id) {\n140\t      spec.model = event.actor.id;\n141\t    }\n142\t    specs.push(spec);\n143\t  }\n144\t\n145\t  const lines: SessionLine[] = [];\n146\t  let