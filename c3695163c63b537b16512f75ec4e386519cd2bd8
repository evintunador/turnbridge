{"content":{"blocks":[{"content":[{"text":"import type { EvidenceEvent } from \"conversation-ledger\";\n\n/** Canonical names for supported CLIs, matching cledger's `producer.source`. */\nexport type CliName = \"claude-code\" | \"codex\";\n\nexport const SUPPORTED_CLIS: CliName[] = [\"claude-code\", \"codex\"];\n\n/** Normalize user-typed CLI names (`claude`, `claude-code`, `codex`). */\nexport function parseCliName(input: string): CliName | null {\n  const s = input.trim().toLowerCase();\n  if (s === \"claude\" || s === \"claude-code\" || s === \"claude_code\") return \"claude-code\";\n  if (s === \"codex\") return \"codex\";\n  return null;\n}\n\nexport function cliLabel(name: string): string {\n  if (name === \"claude-code\") return \"Claude Code\";\n  if (name === \"codex\") return \"Codex\";\n  return name;\n}\n\n/** A conversation reconstructed from ledger events, ready for listing/resume. */\nexport interface ConversationSummary {\n  /** Namespaced ledger id, e.g. `claude-code:<session-uuid>`. */\n  id: string;\n  /** Originating CLI (`producer.source`). */\n  source: string;\n  /** Native session id in the source CLI. */\n  sessionId: string;\n  /** First meaningful human message, truncated for display. */\n  title: string;\n  firstActivity: string;\n  lastActivity: string;\n  turnCount: number;\n  /** Distinct human actor ids (git emails); empty when captured pre-identity. */\n  owners: string[];\n  ownerDisplays: string[];\n  /** All turn events, in canonical order. */\n  events: EvidenceEvent[];\n}\n\n/** One normalized content block inside a turn (subset turnbridge consumes). */\nexport interface TurnBlock {\n  type?: string;\n  text?: string;\n  name?: string;\n  id?: string;\n  input?: unknown;\n  tool_use_id?: string;\n  content?: unknown;\n  [key: string]: unknown;\n}\n\nexport interface TurnContent {\n  role: string;\n  blocks: TurnBlock[];\n}\n\n/** Parse a ledger `conversation_turn` content payload; null when malformed. */\nexport function turnContent(event: EvidenceEvent): TurnContent | null {\n  const c = event.content as { role?: unknown; blocks?: unknown } | null;\n  if (!c || typeof c !== \"object\") return null;\n  if (typeof c.role !== \"string\" || !Array.isArray(c.blocks)) return null;\n  return { role: c.role, blocks: c.blocks as TurnBlock[] };\n}","type":"input_text"}],"tool_use_id":"toolu_01BdfEmpSZ9H6vDPXxqr6zFR","type":"tool_result"}],"role":"tool_result"},"context":{"branch":"annals-cledger","cwd":"/Users/evintunador/repos/evintunador/turnbridge","head":"c3695163c63b537b16512f75ec4e386519cd2bd8","repo":"git@github.com:evintunador/turnbridge.git"},"id":"ev2-148cefe5c0cb5ce64c720f835f7aaeb7dbbb176a375b6dfd7f5ae7fda2f18905","kind":"conversation_turn","meta":{"actor":{"type":"system"},"model":"gpt-5.6-sol","provider":"openai","session_id":"9d261764-bb80-489b-a27a-efbf8948150d","source":"codex","source_version":"0.156.1"},"occurred_at":"2026-07-24T05:02:47.920Z","producer":{"tool":"cledger","version":"0.26.0"},"raw":{"data":{"payload":{"call_id":"toolu_01BdfEmpSZ9H6vDPXxqr6zFR","output":[{"text":"import type { EvidenceEvent } from \"conversation-ledger\";\n\n/** Canonical names for supported CLIs, matching cledger's `producer.source`. */\nexport type CliName = \"claude-code\" | \"codex\";\n\nexport const SUPPORTED_CLIS: CliName[] = [\"claude-code\", \"codex\"];\n\n/** Normalize user-typed CLI names (`claude`, `claude-code`, `codex`). */\nexport function parseCliName(input: string): CliName | null {\n  const s = input.trim().toLowerCase();\n  if (s === \"claude\" || s === \"claude-code\" || s === \"claude_code\") return \"claude-code\";\n  if (s === \"codex\") return \"codex\";\n  return null;\n}\n\nexport function cliLabel(name: string): string {\n  if (name === \"claude-code\") return \"Claude Code\";\n  if (name === \"codex\") return \"Codex\";\n  return name;\n}\n\n/** A conversation reconstructed from ledger events, ready for listing/resume. */\nexport interface ConversationSummary {\n  /** Nam