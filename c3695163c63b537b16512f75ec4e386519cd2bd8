timestamp, role, text)];\n96\t}\n97\t\n98\texport function buildRolloutLines(\n99\t  summary: ConversationSummary,\n100\t  sessionId: string,\n101\t  cwd: string,\n102\t  cliVersion: string,\n103\t  now: Date,\n104\t): RolloutLine[] {\n105\t  const nowIso = now.toISOString();\n106\t  const lines: RolloutLine[] = [\n107\t    {\n108\t      timestamp: nowIso,\n109\t      type: \"session_meta\",\n110\t      payload: {\n111\t        session_id: sessionId,\n112\t        id: sessionId,\n113\t        timestamp: nowIso,\n114\t        cwd,\n115\t        originator: \"codex-tui\",\n116\t        cli_version: cliVersion,\n117\t        source: \"cli\",\n118\t        thread_source: \"user\",\n119\t        model_provider: \"openai\",\n120\t        history_mode: \"legacy\",\n121\t      },\n122\t    },\n123\t    ...turnLines(\n124\t      nowIso,\n125\t      \"user\",\n126\t      `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n127\t        \"The history below is the literal visible transcript; hidden reasoning and provider-private \" +\n128\t        \"state were not transferred, and past tool calls are shown as labeled text, not replayable calls.\",\n129\t    ),\n130\t  ];\n131\t\n132\t  for (const event of summary.events) {\n133\t    const content = turnContent(event);\n134\t    if (!content) continue;\n135\t    const text = content.blocks.map(foldBlock).filter((t) => t.trim()).join(\"\\n\\n\");\n136\t    if (!text) continue;\n137\t    const role = event.actor.type === \"human\" ? \"user\" : \"assistant\";\n138\t    lines.push(...turnLines(event.occurred_at, role, text));\n139\t  }\n140\t  return lines;\n141\t}\n142\t\n143\texport const codexTarget: TargetAdapter = {\n144\t  name: \"codex\",\n145\t  binary: \"codex\",\n146\t\n147\t  isInstalled() {\n148\t    return binaryOnPath(\"codex\");\n149\t  },\n150\t\n151\t  nativeResume(sessionId: string, cwd: string): LaunchPlan {\n152\t    return {\n153\t      command: \"codex\",\n154\t     