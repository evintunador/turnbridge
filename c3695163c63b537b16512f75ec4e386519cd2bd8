{"content":{"blocks":[{"content":[{"text":"1\t// Probe: does codex resume accept a REAL encrypted reasoning item replayed\n2\t// inside a fabricated rollout (same account, different session)? This is the\n3\t// load-bearing unknown for recording encrypted_content in cledger: if the\n4\t// API rejects cross-session replay, the capture-policy debate is moot.\n5\timport { spawnSync } from \"node:child_process\";\n6\timport { mkdtemp, readFile, writeFile } from \"node:fs/promises\";\n7\timport { tmpdir } from \"node:os\";\n8\timport { join } from \"node:path\";\n9\timport process from \"node:process\";\n10\timport { appendEvents, findRepo, git } from \"conversation-ledger\";\n11\timport { listConversations, targetFor } from \"../dist/index.js\";\n12\t\n13\t// Donor: any real rollout containing a `reasoning` response_item with\n14\t// encrypted_content (find one: grep -rl encrypted_content ~/.codex/sessions).\n15\t// Verified 2026-07-21: same-account replay accepted across sessions and\n16\t// across CLI versions (0.144-created blob, resumed under 0.145). Still\n17\t// unverified: cross-account replay (needs a second OpenAI account).\n18\tconst DONOR = process.argv[2];\n19\tif (!DONOR) throw new Error(\"usage: probe-encrypted-reasoning.mjs <donor-rollout.jsonl>\");\n20\t\n21\t// 1. Extract a real reasoning line (envelope + payload verbatim) from the donor.\n22\tconst donorLines = (await readFile(DONOR, \"utf8\")).split(\"\\n\").filter(Boolean).map(JSON.parse);\n23\tconst reasoningLine = donorLines.find(\n24\t  (l) => l.type === \"response_item\" && l.payload?.type === \"reasoning\" && l.payload?.encrypted_content,\n25\t);\n26\tif (!reasoningLine) throw new Error(\"donor has no encrypted reasoning response_item\");\n27\tconsole.log(\n28\t  `donor reasoning item: id=${reasoningLine.payload.id ?? \"(none)\"} blob=${reasoningLine.payload.encrypted_content.length} chars`,\n29\t);\n30\t\n31\t// 2. Seed a marker conversation and fabricate a codex session from it.\n32\tconst MARKER = `TB-ENCPROBE-${Math.random().toString(36).slice(2, 8)}`;\n33\tconst dir = await mkdtemp(join(tmpdir(), \"turnbridge-encprobe-\"));\n34\tawait git([\"init\", \"-q\", \"-b\", \"main\"], { cwd: dir });\n35\tawait git([\"config\", \"user.email\", \"smoke@turnbridge.test\"], { cwd: dir });\n36\tawait git([\"config\", \"user.name\", \"Turnbridge Smoke\"], { cwd: dir });\n37\tawait git([\"config\", \"commit.gpgsign\", \"false\"], { cwd: dir });\n38\tawait writeFile(join(dir, \"README.md\"), \"probe\\n\");\n39\tawait git([\"add\", \".\"], { cwd: dir });\n40\tawait git([\"commit\", \"-q\", \"-m\", \"init\"], { cwd: dir });\n41\tconst repo = await findRepo(dir);\n42\t\n43\tconst conversationId = `claude-code:${crypto.randomUUID()}`;\n44\tconst turn = (role, text, seq) => ({\n45\t  kind: \"conversation_turn\",\n46\t  occurred_at: `2026-01-01T00:00:0${seq}.000Z`,\n47\t  actor: role === \"user\" ? { type: \"human\", id: \"smoke@turnbridge.test\" } : { type: \"agent\", id: \"probe-model\" },\n48\t  producer: { tool: \"turnbridge-smoke\", source: \"claude-code\", session_id: conversationId.split(\":\")[1] },\n49\t  conversation: { id: conversationId, seq },\n50\t  content: { role, blocks: [{ type: \"text\", text }] },\n51\t});\n52\tawait appendEvents(repo, [\n53\t  turn(\"user\", `The secret marker phrase is ${MARKER}. Remember it.`, 0),\n54\t  turn(\"assistant\", `Noted. I will recall the marker phrase when asked.`, 1),\n55\t]);\n56\tconst summary = (await listConversations(repo, { all: true })).find((c) => c.id === conversationId);\n57\tconst plan = await targetFor(\"codex\").fabricate(summary, dir);\n58\tconst sessionId = plan.fabricatedConversationId.split(\":\")[1];\n59\tconst rolloutPath = plan.notes.find((n) => n.includes(\"rollout file:\")).split(\"rollout file: \")[1];\n60\tconsole.log(`fabricated session ${sessionId}`);\n61\t\n62\t// 3. Inject the donor reasoning item immediately before the final assistant\n63\t//    message response_item (where a real turn's reasoning would sit).\n64\tconst lines = (await readFile(rolloutPath, \"utf8\")).split(\"\\n\").filter(Boolean).map(JSON.parse);\n65\tlet insertAt = -1;\n66\tfor (let i = lines.length - 1; i >= 0; i--) {\n67\t  if (lines[i].type === \"response_item\" && lines[i].payload?.type === \"message\" && lines[i].payload?.role === \"assistant\") {\n68\t    insertAt = i;\n69\t    break;\n70\t  }\n71\t}\n72\tif (insertAt < 0) throw new Error(\"no assistant response_item in fabricated rollout\");\n73\tconst injected = { ...reasoningLine, timestamp: lines[insertAt].timestamp };\n74\tlines.splice(insertAt, 0, injected);\n75\tawait writeFile(rolloutPath, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n76\tconsole.log(`injected reasoning item before line ${insertAt}`);\n77\t\n78\t// 4. Resume headless and ask for the marker.\n79\tconst env = Object.fromEntries(\n80\t  Object.entries(process.env).filter(([k]) => !/^(CLAUDE|CLAUDECODE|CODEX_[A-Z])/.test(k)),\n81\t);\n82\tconst result = spawnSync(\n83\t  \"codex\",\n84\t  [\"exec\", \"--skip-git-repo-check\", \"resume\", sessionId,\n85\t   \"Reply with only the secret marker phrase from earlier in this conversation, nothing else.\"],\n86\t  { cwd: dir, encoding: \"utf8\", env, timeout: 180_000 },\n87\t);\n88\tconst out = (result.stdout ?? \"\") + (result.stderr ?? \"\");\n89\tconsole.log(\"--- codex exec output (tail) ---\");\n90\tconsole.log(out.split(\"\\n\").slice(-15).join(\"\\n\"));\n91\tconst errors = out.match(/\\b(400|invalid|rejected|unauthorized|decrypt\\w*)\\b/gi);\n92\tconsole.log(`error-indicator scan: ${errors ? JSON.stringify([...new Set(errors)]) : \"none\"}`);\n93\tconsole.log(\n94\t  out.includes(MARKER)\n95\t    ? `PROBE PASS: resume accepted the replayed encrypted reasoning and recalled ${MARKER}`\n96\t    : \"PROBE FAIL: marker not recalled (see output above for whether the API rejected the reasoning item)\",\n97\t);\n98\tprocess.exit(out.includes(MARKER) ? 0 : 1);\n99\t","type":"input_text"}],"tool_use_i