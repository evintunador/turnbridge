{"content":{"blocks":[{"content":[{"text":"140\t];\n141\t\n142\tasync function smokeTarget(name, repo, conversationId, artifactsDir) {\n143\t  const target = targetFor(name);\n144\t  if (!(await target.isInstalled())) {\n145\t    return { name, status: \"skip\", detail: `${target.binary} not on PATH` };\n146\t  }\n147\t  // Select by id: capture hooks installed on this machine may have already\n148\t  // recorded the previous target's smoke session as a newer conversation.\n149\t  const summary = (await listConversations(repo, { all: true })).find(\n150\t    (c) => c.id === conversationId,\n151\t  );\n152\t  if (!summary) throw new Error(\"seeded conversation not visible to listConversations\");\n153\t\n154\t  const plan = await target.fabricate(summary, repo.root);\n155\t  const logPath = join(artifactsDir, `${name}.pty.log`);\n156\t\n157\t  const { stripped, earlyExit } = await runInPty({\n158\t    command: plan.command,\n159\t    args: plan.args,\n160\t    cwd: repo.root,\n161\t    logPath,\n162\t    settleSeconds: 20,\n163\t  });\n164\t  await writeFile(join(artifactsDir, `${name}.stripped.txt`), stripped);\n165\t\n166\t  // Success: both planted markers visible in the rendered scrollback.\n167\t  const satisfied = stripped.includes(USER_MARKER) && stripped.includes(ASSISTANT_MARKER);\n168\t  const glitches = [];\n169\t  for (const [re, label] of GLITCH_PATTERNS) {\n170\t    const m = stripped.match(re);\n171\t    if (m) glitches.push(`${label} (matched: ${JSON.stringify(m[0])})`);\n172\t  }\n173\t  return {\n174\t    name,\n175\t    status: satisfied ? \"pass\" : \"fail\",\n176\t    detail: satisfied\n177\t      ? \"both markers rendered in the interactive TUI\"\n178\t      : earlyExit\n179\t        ? \"TUI exited before the settle window ended (see capture)\"\n180\t        : \"markers never appeared in TUI render before timeout\",\n181\t    glitches,\n182\t    sessionNote: plan.notes.find((n) => n.includes(\"session\") || n.includes(\"rollout\")) ?? \"\",\n183\t  };\n184\t}\n185\t\n186\tconst argv = process.argv.slice(2);\n187\tconst manual = argv.includes(\"--manual\");\n188\tconst pick = argv.find((a) => !a.startsWith(\"--\")) ?? \"all\";\n189\tconst names = pick === \"all\" ? [\"claude-code\", \"codex\"] : [pick];\n190\tconst artifactsDir = await mkdtemp(join(tmpdir(), \"turnbridge-smoke-artifacts-\"));\n191\tawait mkdir(artifactsDir, { recursive: true });\n192\tconst { repo, conversationId } = await makeSeededRepo(artifactsDir);\n193\t\n194\tif (manual) {\n195\t  const out = [];\n196\t  out.push(\"\", \"Manual TUI inspection — sessions fabricated, nothing launched.\", \"\");\n197\t  for (const name of names) {\n198\t    const target = targetFor(name);\n199\t    if (!(await target.isInstalled())) {\n200\t      out.push(`[skip] ${name}: ${target.binary} not on PATH`, \"\");\n201\t      continue;\n202\t    }\n203\t    const summary = (await listConversations(repo, { all: true })).find(\n204\t      (c) => c.id === conversationId,\n205\t    );\n206\t    const plan = await target.fabricate(summary, repo.root);\n207\t    out.push(\n208\t      `[${name}] run this in a normal terminal (not inside another agent session):`,\n209\t      \"\",\n210\t      `    cd ${repo.root} && ${plan.command} ${plan.args.join(\" \")}`,\n211\t      \"\",\n212\t      ...plan.notes.map((n) => `    note: ${n}`),\n213\t      \"\",\n214\t    );","type":"input_text"}],"tool_use_id":"toolu_015rZzfnKQ7PjX8TWfXdvytt","type":"tool_result"}],"role":"tool_result"},"context":{"branch":"annals-cledger","cwd":"/Users/evintunador/repos/evintunador/turnbridge","head":"c3695163c63b537b16512f75ec4e386519cd2bd8","repo":"git@github.com:evintunador/turnbridge.git"},"id":"ev2-ebeea83ac3a45647a10eef98d20986d0bc3c6dd5140049d04797a936e9886552","kind":"conversation_turn","meta":{"actor":{"type":"system"},"model":"gpt-5.6-sol","provider":"openai","session_id":"9d261764-bb80-489b-a27a-efbf8948150d","source":"codex","source_version":"0.156.1"},"occurred_at":"2026-07-24T06:42