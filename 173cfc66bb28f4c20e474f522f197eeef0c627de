{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t#!/usr/bin/env node\n2\t\"use strict\";\n3\t// sticky-utils.js — Shared utilities for Sticky Note hooks.\n4\t// Copied into .sticky-note/hooks/ during `npx sticky-note init` and required by all hook scripts.\n5\t// Exports helpers for path resolution, JSON I/O, git operations, thread management, audit logging, and pattern matching.\n6\t// Do not edit this file directly in .sticky-note/hooks/ — edit the template at templates/hooks/sticky-utils.js instead.\n7\t\n8\tconst fs = require(\"fs\");\n9\tconst path = require(\"path\");\n10\tconst { execFileSync } = require(\"child_process\");\n11\t\n12\t// ── Cross-platform path normalization ──────────────────────\n13\t\n14\t// Normalize path separators to forward slashes for consistent storage/comparison.\n15\tfunction normalizeSep(p) {\n16\t  return typeof p === \"string\" ? p.replace(/\\\\/g, \"/\") : p;\n17\t}\n18\t\n19\t// ── Shared regex patterns ─────────────────────────────────\n20\t\n21\tconst ERROR_PATTERNS = new RegExp(\n22\t  \"(error|exception|traceback|failed|fatal|panic|ENOENT|EACCES|\" +\n23\t    \"segfault|undefined|TypeError|SyntaxError|ReferenceError|\" +\n24\t    \"ImportError|ModuleNotFoundError|KeyError|ValueError|\" +\n25\t    \"RuntimeError|ConnectionError|TimeoutError|PermissionError)\",\n26\t  \"i\"\n27\t);\n28\t\n29\tconst RETRY_PATTERNS = new RegExp(\n30\t  \"(try again|let me try|didn't work|doesn't work|failed|let's try|\" +\n31\t    \"another approach|instead|alternatively|that approach|this doesn't|\" +\n32\t    \"that didn't|won't work|can't|cannot)\",\n33\t  \"i\"\n34\t);\n35\t\n36\tconst FILE_PATH_PATTERN = /[\\w./\\\\-]+\\.\\w{1,10}/g;\n37\t\n38\t// ── Path helpers ──────────────────────────────────────────\n39\t\n40\tfunction _stickyDir() {\n41\t  try {\n42\t    const gitDir = execFileSync(\"git\", [\"rev-parse\", \"--absolute-git-dir\"], {\n43\t      encoding: \"utf-8\", timeout: 3000, stdio: [\"pipe\", \"pipe\", \"pipe\"],\n44\t    }).trim();\n45\t    return path.resolve(gitDir, \"sticky-note\");\n46\t  } catch (_) {\n47\t    // Fallback for non-git environments (e.g., unit tests without git init)\n48\t    const scriptDir = path.dirname(path.resolve(__filename));\n49\t    return path.join(scriptDir, \"..\", \"..\", \".sticky-note\");\n50\t  }\n51\t}\n52\t\n53\t// ── Error logging ─────────────────────────────────────────\n54\t\n55\tfunction logHookError(hookName, error) {\n56\t  try {\n57\t    const logPath = path.join(_stickyDir(), \".sticky-errors.log\");\n58\t    const ts = new Date().toISOString();\n59\t    const msg = error instanceof Error ? error.stack || error.message : String(error);\n60\t    const line = `[${ts}] ${hookName}: ${msg}\\n`;\n61\t    fs.mkdirSync(path.dirname(logPath), { recursive: true });\n62\t    fs.appendFileSync(logPath, line, \"utf-8\");\n63\t  } catch (_) {\n64\t    // Last resort — can't even log the error\n65\t  }\n66\t}\n67\t\n68\t// Issue #14: Surface hook failures to stderr so the host tool's generic\n69\t// \"<HookName> hook error\" message has actionable detail next to it. Earlier\n70\t// versions silently swallowed `require()` failures and top-level exceptions,\n71\t// which made stale-path issues (#13) and other crashes impossible to diagnose\n72\t// — particularly under UserPromptSubmit, which Claude Code reports without\n73\t// a stack trace. This helper prefixes every line with `[STICKY-NOTE]` so the\n74\t// user can spot it in mixed hook output.\n75\tfunction reportHookError(hookName, error, hint) {\n76\t  const msg = error instanceof Error ? (error.stack || error.message) : String(error);\n77\t  const lines = [`[STICKY-NOTE] ${hookName} hook error: ${msg}`];\n78\t  if (hint) lines.push(`[STICKY-NOTE]   hint: ${hint}`);\n79\t  try { process.stderr.write(lines.join(\"\\n\") + \"\\n\"); } catch (_) { /* ignore */ }\n80\t  try { logHookError(hookName, error); } catch (_) { /* ignore */ }\n81\t}\n82\t\n83\t// Issue #13: When a teammate copies `.claude/settings.json` from another\n84\t// machine (or runs an older sticky-note-cli that wrote absolute paths), the\n85\t// hook commands point at non-existent absolute paths and every hook fails\n86\t// with MODULE_NOT_FOUND. Re-running `npx sticky-note init` fixes it, but\n87\t// users typically don't know that — they just see \"<Hook> hook error\" each\n88\t// session. This helper detects and rewrites those stale commands in-place\n89\t// the first time any hook (e.g. session-start, inject-context) successfully\n90\t// loads, so the next session starts clean.\n91\t//\n92\t// The rewritten command uses `npx sticky-note run-hook <basename>` which walks\n93\t// up the directory tree to find `.claude/hooks/<basename>.js`, so it works even\n94\t// when Claude Code is launched from a subdirectory of the project root.\n95\t// We extract `<basename>` from the existing command so we never invent hook\n96\t// scripts that don't exist.\n97\t//\n98\t// Returns the list of (hookEvent, oldCommand, newCommand) tuples that were\n99\t// rewritten, or [] if nothing was stale.\n100\tfunction selfHealHookPaths(settingsPath) {\n101\t  const result = [];\n102\t  try {\n103\t    if (!settingsPath) {\n104\t      settingsPath = path.join(process.cwd(), \".claude\", \"settings.json\");\n105\t    }\n106\t    if (!fs.existsSync(settingsPath)) return result;\n107\t\n108\t    const raw = fs.readFileSync(settingsPath, \"utf-8\");\n109\t    let settings;\n110\t    try { settings = JSON.parse(raw); } catch (_) { return result; }\n111\t    if (!settings || !settings.hooks) return result;\n112\t\n113\t    // Two stale patterns:\n114\t    // 1. Absolute paths (written by older sticky-note-cli or copied from another machine)\n115\t    // 2. Old relative form `node \".claude/hooks/foo.js\"` — fails when Claude Code\n116\t    //    launches from a subdirectory, because the path resolves relative to the\n117\t    //    launch cwd, not the directory containing .claude/settings.json.\n118\t    const STALE_ABSOLUTE = /[\"'][A-Za-z]:[\\\\/]|[\"']\\/(?:Users|home|root|tmp)\\/|\\$\\(git rev-parse/;\n119\t    const STALE_RELATIVE = /^node\\s+[\"']\\.claude[\\\\/]hooks[\\\\/][^\"']+\\.js[\"']\\s*$/;\n120\t    // Match the script basename in either quoted or bare form.\n121\t    const BASENAME = /([A-Za-z0-9_.-]+)\\.(?:js|sh|cjs|mjs)(?:[\"'`\\s]|$)/;\n122\t\n123\t    let changed = false;\n124\t    for (const [event, entries] of Object.entries(settings.hooks)) {\n125\t      if (!Array.isArray(entries)) continue;\n126\t      for (const entry of entries) {\n127\t        for (const h of (entry && entry.hooks) || []) {\n128\t          const cmd = h && h.command;\n129\t          if (typeof cmd !== \"string\") continue;\n130\t          const isStale = STALE_ABSOLUTE.test(cmd) || STALE_RELATIVE.test(cmd);\n131\t          if (!isStale) continue;\n132\t          const m = cmd.match(BASENAME);\n133\t          if (!m) continue;\n134\t          const basename = m[1];\n135\t          const newCmd = `npx sticky-note run-hook ${basename}`;\n136\t          result.push({ event, oldCommand: cmd, newCommand: newCmd });\n137\t          h.command = newCmd;\n138\t          changed = true;\n139\t        }\n140\t      }\n141\t    }\n142\t\n143\t    if (!changed) return result;\n144\t\n145\t    fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + \"\\n\", \"utf-8\");\n146\t    try {\n147\t      const summary =\n148\t        `[STICKY-NOTE] ⚠️  Detected ${result.length} stale hook path(s) in ` +\n149\t        `${path.relative(process.cwd(), settingsPath) || settingsPath} — rewrote to ` +\n150\t        `\"npx sticky-note run-hook <name>\" so hooks work from any subdirectory. ` +\n151\t        `Commit the change to share the fix with your team.`;\n152\t      process.stderr.write(summary + \"\\n\");\n153\t      for (const { event, oldCommand, newCommand } of result.slice(0, 5)) {\n154\t        process.stderr.write(`[STICKY-NOTE]   ${event}: ${oldCommand} → ${newCommand}\\n`);\n155\t      }