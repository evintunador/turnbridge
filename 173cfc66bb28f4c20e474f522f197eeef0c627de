{"actor":{"type":"system"},"content":{"blocks":[{"content":"30\t/// Claude Code provider implementation.\n31\tpub struct ClaudeCode;\n32\t\n33\t/// Derive Claude Code's project directory key from a workspace path.\n34\t///\n35\t/// Reverse-engineered from real Claude Code installations: every non-alphanumeric\n36\t/// character is replaced by `-` while alphanumeric characters (including case)\n37\t/// are preserved.\n38\t///\n39\t/// Examples:\n40\t/// - `/data/projects/cross_agent_session_resumer` -> `-data-projects-cross-agent-session-resumer`\n41\t/// - `/data/projects/jeffreys-skills.md` -> `-data-projects-jeffreys-skills-md`\n42\tpub fn project_dir_key(workspace: &Path) -> String {\n43\t    workspace\n44\t        .to_string_lossy()\n45\t        .chars()\n46\t        .map(|ch| if ch.is_ascii_alphanumeric() { ch } else { '-' })\n47\t        .collect()\n48\t}\n49\t\n50\timpl ClaudeCode {\n51\t    /// Root directory for Claude Code sessions.\n52\t    /// Respects `CLAUDE_HOME` env var override.\n53\t    fn home_dir() -> Option<PathBuf> {\n54\t        if let Ok(home) = std::env::var(\"CLAUDE_HOME\") {\n55\t            return Some(PathBuf::from(home));\n56\t        }\n57\t        dirs::home_dir().map(|h| h.join(\".claude\"))\n58\t    }\n59\t\n60\t    /// Projects directory where session files live.\n61\t    fn projects_dir() -> Option<PathBuf> {\n62\t        Self::home_dir().map(|h| h.join(\"projects\"))\n63\t    }\n64\t}\n65\t\n66\timpl Provider for ClaudeCode {\n67\t    fn name(&self) -> &str {\n68\t        \"Claude Code\"\n69\t    }\n70\t\n71\t    fn slug(&self) -> &str {\n72\t        \"claude-code\"\n73\t    }\n74\t\n75\t    fn cli_alias(&self) -> &str {\n76\t        \"cc\"\n77\t    }\n78\t\n79\t    fn detect(&self) -> DetectionResult {\n80\t        let mut evidence = Vec::new();\n81\t        let mut installed = false;\n82\t\n83\t        // Check for binary in PATH.\n84\t        if which::which(\"claude\").is_ok() {\n85\t            evidence.push(\"claude binary 