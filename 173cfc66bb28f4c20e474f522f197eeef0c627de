{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport assert from \"node:assert/strict\";\n2\timport test from \"node:test\";\n3\timport { buildRolloutLines } from \"../targets/codex.js\";\n4\timport { listConversations } from \"../conversations.js\";\n5\timport { cleanupRepo, makeTempRepo, seedConversation } from \"./helpers.js\";\n6\t\n7\tconst SID = \"44444444-4444-4444-8444-444444444444\";\n8\tconst NEW_ID = \"99999999-9999-4999-8999-999999999999\";\n9\t\n10\ttest(\"builds a minimal valid rollout: session_meta + message response_items\", async () => {\n11\t  const repo = await makeTempRepo();\n12\t  try {\n13\t    await seedConversation(repo, `claude-code:${SID}`, \"claude-code\", [\n14\t      { role: \"user\", text: \"add a retry to the fetcher\", seq: 0, email: \"me@x.com\" },\n15\t      { role: \"assistant\", text: \"Done, retries three times.\", seq: 1 },\n16\t    ]);\n17\t    const [summary] = await listConversations(repo, { all: true });\n18\t    const lines = buildRolloutLines(summary!, NEW_ID, \"/work/dir\", \"0.144.6\", new Date());\n19\t\n20\t    const meta = lines[0]!;\n21\t    assert.equal(meta.type, \"session_meta\");\n22\t    assert.equal(meta.payload[\"id\"], NEW_ID);\n23\t    assert.equal(meta.payload[\"session_id\"], NEW_ID);\n24\t    assert.equal(meta.payload[\"cwd\"], \"/work/dir\");\n25\t    assert.equal(meta.payload[\"cli_version\"], \"0.144.6\");\n26\t\n27\t    // import notice first, then the two turns — as model-context response_items\n28\t    const messages = lines\n29\t      .filter((l) => l.type === \"response_item\")\n30\t      .map((l) => l.payload as Record<string, unknown>);\n31\t    assert.equal(messages.length, 3);\n32\t    assert.match(\n33\t      (messages[0]![\"content\"] as { text: string }[])[0]!.text,\n34\t      /imported from Claude Code/,\n35\t    );\n36\t    assert.equal(messages[1]![\"role\"], \"user\");\n37\t    assert.deepEqual(messages[1]![\"content\"], [\n38\t      { type: \"input_text\", text: \"add