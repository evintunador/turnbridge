{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t#!/usr/bin/env node\n2\t/**\n3\t * sticky-note MCP server — stdio-based\n4\t *\n5\t * Implements Model Context Protocol (JSON-RPC 2.0 over stdin/stdout)\n6\t * with 8 tools for AI assistants:\n7\t *\n8\t *   get_session_context(id)              — full thread payload by ID\n9\t *   get_stuck_threads()                  — all stuck threads\n10\t *   search_threads(query)               — keyword search across threads\n11\t *   get_audit_trail(...)                — query per-user JSONL audit logs\n12\t *   get_presence()                      — current presence data\n13\t *   check_overlaps(files)               — overlap detection for edit gating\n14\t *   get_environment_status()            — environment sync status\n15\t *   get_thread_context_for_files(files) — thread attribution for files\n16\t *\n17\t * Zero external dependencies. Node >= 16.\n18\t *\n19\t * Usage:\n20\t *   node bin/mcp-server.js                    (uses cwd)\n21\t *   node bin/mcp-server.js --project /path    (explicit project root)\n22\t */\n23\t\n24\tconst fs = require(\"fs\");\n25\tconst path = require(\"path\");\n26\t\n27\t// ──────────────────────────────────────────────\n28\t// Project root resolution\n29\t// ──────────────────────────────────────────────\n30\t\n31\tlet PROJECT_ROOT = process.cwd();\n32\tconst args = process.argv.slice(2);\n33\tfor (let i = 0; i < args.length; i++) {\n34\t  if (args[i] === \"--project\" && args[i + 1]) {\n35\t    PROJECT_ROOT = path.resolve(args[i + 1]);\n36\t  }\n37\t}\n38\t\n39\tfunction stickyDir() {\n40\t  return path.join(PROJECT_ROOT, \".sticky-note\");\n41\t}\n42\t\n43\t// ──────────────────────────────────────────────\n44\t// File helpers\n45\t// ──────────────────────────────────────────────\n46\t\n47\tfunction readJsonSafe(filePath, fallback) {\n48\t  try {\n49\t    return JSON.parse(fs.readFileSync(filePath, \"utf-8\"));\n50\t  } catch {\n51\t    return fallback;\n52\t  }\n53\t}\n54\t\n