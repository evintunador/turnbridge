odel;\n      info.summary = { diffs: [] };\n      lastUserId = msgId;\n    }\n\n    messages.push({ info, parts });\n  }\n\n  return {\n    info: {\n      id: sessionId,\n      slug: `tb-${sessionId.slice(0, 8)}`,\n      projectID: projectId,\n      directory: cwd,\n      path: \"\",\n      title: pickerTitle(summary),\n      agent: \"build\",\n      model: { id: sourceModel, providerID: \"turnbridge\" },\n      version,\n      summary: { additions: 0, deletions: 0, files: 0 },\n      cost: 0,\n      tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },\n      time: { created: nowMs, updated: nowMs },\n    },\n    messages,\n  };\n}\n\n/** Best-effort removal of a session a failed import left half-written. */","filePath":"/Users/evintunador/repos/evintunador/turnbridge/src/targets/opencode.ts","numLines":140,"startLine":280,"totalLines":538},"type":"text"},"type":"user","userType":"external","uuid":"a15b5e1e-a5a5-4363-9875-1b00570d1977","version":"2.1.227"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-11T11:42:59.034Z","schema":"annals/v1","stream":{"id":"claude-code:4fc5e727-a1d5-4399-a448-9d24a0ce9c15","seq":679}}
