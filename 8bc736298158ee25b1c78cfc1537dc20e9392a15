{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Sync-time secret scan (layer E, see docs/WIP_TECHNICAL_DESIGN.md \"Privacy\n3\t * and integrity\"). Unlike capture-tier redaction (apply.ts), this scanner\n4\t * never rewrites anything — it only reports findings so a human can decide\n5\t * whether to `cledger redact` the event, `cledger allow` the fingerprint as\n6\t * a known false positive, or push anyway with `--no-scan`. Rules may\n7\t * therefore be noisier than the capture tier.\n8\t */\n9\timport { mkdir, readFile, writeFile } from \"node:fs/promises\";\n10\timport { join } from \"node:path\";\n11\timport { sha256Hex } from \"../canonical.js\";\n12\timport type { RepoInfo } from \"../git.js\";\n13\timport type { EvidenceEvent } from \"../schema.js\";\n14\timport { isExemptFromRedaction, walkStrings } from \"./apply.js\";\n15\timport { rulesForTier, shannonEntropy } from \"./rules.js\";\n16\t\n17\texport interface Finding {\n18\t  eventId: string;\n19\t  conversation?: string;\n20\t  occurred_at: string;\n21\t  rule: string;\n22\t  fingerprint: string;\n23\t  excerpt: string;\n24\t}\n25\t\n26\tconst PLACEHOLDER_RE = /\\[REDACTED:[^\\]]+\\]/g;\n27\t\n28\t/** True if [start, end) overlaps an existing `[REDACTED:...]` placeholder span in `text`. */\n29\tfunction overlapsPlaceholder(text: string, start: number, end: number): boolean {\n30\t  for (const m of text.matchAll(PLACEHOLDER_RE)) {\n31\t    const pStart = m.index ?? 0;\n32\t    const pEnd = pStart + m[0].length;\n33\t    if (start < pEnd && end > pStart) return true;\n34\t  }\n35\t  return false;\n36\t}\n37\t\n38\t/**\n39\t * Marker that stands in for the matched secret in a finding excerpt. Prints\n40\t * zero characters of the secret itself — not even leading/trailing ones —\n41\t * so the excerpt can be safely re-captured (e.g. when the scan report itself\n42\t * lands in a later conversation) without re-seeding the very finding it\n43\t * describes. See the redaction-feedback-loop discussion in the README roadmap.\n44\t */\n45\tconst MATCH_MARKER = \"<redacted>\";\n46\t\n47\t/**\n48\t * ~20 chars of surrounding context on each side, with the matched span\n49\t * replaced by MATCH_MARKER. The context gives a human enough of a \"what was\n50\t * this\" cue to act; the secret's own characters are never printed.\n51\t */\n52\tfunction buildExcerpt(text: string, start: number, end: number): string {\n53\t  const pre = text.slice(Math.max(0, start - 20), start);\n54\t  const post = text.slice(end, end + 20);\n55\t  return `${pre}${MATCH_MARKER}${post}`.replace(/\\s+/g, \" \").trim();\n56\t}\n57\t\n58\tconst PURE_HEX_RE = /^[0-9a-fA-F]+$/;\n59\t\n60\t/**\n61\t * Scan already-finalized events for potential secrets. Read-only: never\n62\t * mutates content, only reports. `tier` selects the ruleset — \"standard\"\n63\t * re-runs the full capture ruleset plus scan-only keyword/URL/bearer rules\n64\t * (catching events captured under an older capture ruleset); \"paranoid\"\n65\t * additionally enables the entropy-gated high-entropy-token rule.\n66\t */\n67\texport function scanEvents(events: EvidenceEvent[], tier: \"standard\" | \"paranoid\"): Finding[] {\n68\t  const rules = rulesForTier(tier);\n69\t  const findings: Finding[] = [];\n70\t\n71\t  for (const event of events) {\n72\t    const visit = (value: string, path: string): string => {\n73\t      if (isExemptFromRedaction(event.kind, path)) return value;\n74\t      for (const rule of rules) {\n75\t        for (const m of value.matchAll(rule.pattern)) {\n76\t          const matchText = m[0];\n77\t          const start = m.index ?? 0;\n78\t          const end = start + matchText.length;\n79\t          if (overlapsPlaceholder(value, start, end)) continue;\n80\t          if (rule.entropyGated) {\n81\t            // Belt-and-suspenders: rulesForTier already excludes this rule\n82\t            // below \"paranoid\", but the gate is cheap to state explicitly.\n83\t            if (tier !== \"paranoid\") continue;\n84\t            if (PURE_HEX_RE.test(matchText)) continue; // git SHAs, content digests\n85\t            if (matchText.includes(\"[REDACTED:\")) continue;\n86\t            if (shannonEntropy(matchText) < 4.0) continue;\n87\t          }\n88\t          findings.push({\n89\t            eventId: event.id,\n90\t            ...(event.conversation ? { conversation: event.conversation.id } : {}),\n91\t            occurred_at: event.occurred_at,\n92\t            rule: rule.id,\n93\t            fingerprint: sha256Hex(matchText).slice(0, 12),\n94\t            excerpt: buildExcerpt(value, start, end),\n95\t          });\n96\t        }\n97\t      }\n98\t      return value;\n99\t    };\n100\t    walkStrings(event.content, \"content\", visit);\n101\t    if (event.raw) walkStrings(event.raw.data, \"raw/data\", visit);\n102\t  }\n103\t\n104\t  return findings;\n105\t}\n106\t\n107\t/** One human-readable line per finding — never includes the secret itself. */\n108\texport function formatFinding(f: Finding): string {\n109\t  return `${f.eventId.slice(0, 16)}  ${f.conversation ?? \"-\"}  ${f.occurred_at}  ${f.rule}  ${f.excerpt}  [${f.fingerprint}]`;\n110\t}\n111\t\n112\t/** Findings whose fingerprint has been allowlisted (known false positive) are suppressed. */\n113\texport function filterFindings(findings: Finding[], allowlist: Set<string>): Finding[] {\n114\t  return findings.filter((f) => !allowlist.has(f.fingerprint));\n115\t}\n116\t\n117\tinterface AllowlistFile {\n118\t  fingerprints: string[];\n119\t}\n120\t\n121\tfunction allowlistPath(repo: RepoInfo): string {\n122\t  return join(repo.commonDir, \"conversation-ledger\", \"allowlist.json\");\n123\t}\n124\t\n125\t/** Local, rebuildable-if-lost state — same tier as pending.jsonl/cursors, never the record of truth. */\n126\texport async function loadAllowlist(repo: RepoInfo): Promise<Set<string>> {\n127\t  try {\n128\t    const raw = await readFile(allowlistPath(re