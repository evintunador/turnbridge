n102\t * A foreign tool call as a real `function_call` response_item.\n103\t *\n104\t * Verified safe by scripts/probe-codex-function-call.mjs (codex-cli 0.145.0):\n105\t * a well-formed call/output pair whose `name` is a tool Codex has never heard\n106\t * of (\"Edit\") replays without API rejection, and the resumed model can name\n107\t * the tool it sees. This closes docs/specs/codex-rollout-format.md §8.2, which\n108\t * had flagged foreign names and orphaned outputs as an unverified rejection\n109\t * risk and recommended text-folding until measured.\n110\t *\n111\t * Pairing is what actually matters: the same probe showed an orphaned\n112\t * `function_call_output` does not error, but carries no `name` at all, so the\n113\t * tool's identity is simply lost. Unpaired results stay text-folded, where the\n114\t * name at least survives as prose.\n115\t */\n116\tfunction functionCallLine(timestamp: string, callId: string, name: string, input: unknown): RolloutLine {\n117\t  return {\n118\t    timestamp,\n119\t    type: \"response_item\",\n120\t    payload: {\n121\t      type: \"function_call\",\n122\t      id: `fc_tb_${callId.slice(-16)}`,\n123\t      name,\n124\t      // the Responses API carries arguments as a JSON *string*, not an object\n125\t      arguments: JSON.stringify(input ?? {}),\n126\t      call_id: callId,\n127\t    },\n128\t  };\n129\t}\n130\t\n131\tfunction functionCallOutputLine(timestamp: string, callId: string, output: string): RolloutLine {\n132\t  return {\n133\t    timestamp,\n134\t    type: \"response_item\",\n135\t    payload: {\n136\t      type: \"function_call_output\",\n137\t      call_id: callId,\n138\t      output: [{ type: \"input_text\", text: output }],\n139\t    },\n140\t  };\n141\t}\n142\t\n143\t/** Codex has no generic tool-call `event_msg`, so scrollback gets prose. */\n144\tfunction toolDisplayLine(timestamp: string, text: string): RolloutLine {\n145\t  return displayLine(timestamp, \"assistant\", text);\n146\t}\n147\t\n148\t/**\n149\t * `reasoning` events this fabrication should replay verbatim: opaque\n150\t * `encrypted_content` only the originating provider can decrypt, which the\n151\t * ledger preserves losslessly (raw.data holds the exact original\n152\t * response_item line) but never interprets. Foreign reasoning cannot be\n153\t * forged as a native reasoning item, so replay is gated per-event on\n154\t * `producer.source === \"codex\"` — the only direction this can ever be\n155\t * valid, regardless of how the rest of the conversation's lineage looks.\n156\t */\n157\tfunction eligibleReasoning(summary: ConversationSummary, replayReasoning: boolean): EvidenceEvent[] {\n158\t  if (!replayReasoning) return [];\n159\t  return summary.events.filter((e) => e.kind === \"reasoning\" && e.producer.source === \"codex\");\n160\t}\n161\t\n162\t/** The verbatim `{type: \"response_item\", payload: {type: \"reasoning\", ...}}` line, if shaped as expected. */\n163\tfunction reasoningRolloutLine(event: EvidenceEvent, now: Date): RolloutLine | null {\n164\t  const line = event.raw?.data as { type?: unknown; payload?: unknown } | undefined;\n165\t  if (line?.type !== \"response_item\" || !line.payload || typeof line.payload !== \"object\") return null;\n166\t  return {\n167\t    // Outer rollout field only — `payload` (where the ciphertext lives) stays\n168\t    // byte-identical, since that is what the provider has to be able to decrypt.\n169\t    timestamp: normalizeTimestamp(event.occurred_at, now),\n170\t    type: \"response_item\",\n171\t    payload: line.payload as Record<string, unknown>,\n172\t  };\n173\t}\n174\t\n175\texport function buildRolloutLines(\n176\t  summary: ConversationSummary,\n177\t  sessionId: string,\n178\t  cwd: string,\n179\t  cliVersion: string,\n180\t  now: Date,\n181\t  replayReasoning = true,\n182\t): RolloutLine[] {\n183\t  const nowIso = now.toISOString();\n184\t  const replayCount = eligibleReasoning(summary, replayReasoning).length;\n185\t  // The notice is a factual claim about this specific file, so it has to track\n186\t  // what was actually written: tool calls now replay as real function_call\n187\t  // records (history the model reads, never re-executed), except unpaired\n188\t  // results, which stay prose.\n189\t  const noticeText =\n190\t    `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n191\t    \"The history below is the literal visible transcript. Past tool calls are replayed as history \" +\n192\t    \"records, not as calls to re-run; tool results with no matching call appear as labeled text. \" +\n193\t    (replayCount > 0\n194\t      ? `${replayCount} encrypted reasoning block(s) from the original Codex session were replayed ` +\n195\t        \"verbatim below, which may restore hidden reasoning provider-side; all other hidden reasoning \" +\n196\t        \"and provider-private state were not transferred.\"\n197\t      : \"Hidden reasoning and provider-private state were not transferred.\");\n198\t\n199\t  const lines: RolloutLine[] = [\n200\t    {\n201\t      timestamp: nowIso,\n202\t      type: \"session_meta\",\n203\t      payload: {\n204\t        session_id: sessionId,\n205\t        id: sessionId,\n206\t        timestamp: nowIso,\n207\t        cwd,\n208\t        originator: \"codex-tui\",\n209\t        cli_version: cliVersion,\n210\t        source: \"cli\",\n211\t        thread_source: \"user\",\n212\t        model_provider: \"openai\",\n213\t        history_mode: \"legacy\",\n214\t      },\n215\t    },\n216\t    ...turnLines(nowIso, \"user\", noticeText),\n217\t  ];\n218\t\n219\t  // call_ids seen so far, so a tool_result can tell a real pairing from an\n220\t  // orphan whose matching call never made it into this conversation\n221\t  const seenCallIds = new Set<string>();\n222\t  for (const event of summary.events) {\n223\t    if (event.kind === \"reasoning\") {\n224\t      if (!replayReasoning || event.producer.source !== \"codex\") continue;\n225\t      const line = reasoningRolloutLine(event, now);\n226\t      if (line) lines.push(line);\n227\t      continue;\n228\t    }\n229\t    const content = turnContent(event);\n230\t    if (!content) continue;\n231\t    const ts = normalizeTimestamp(event.occurred_at, now);\n232\t    const role = event.actor.type === \"human\" ? \"user\" : \"assistant\";\n233\t\n234\t    // Prose accumulates until a tool block interrupts it, so a turn's text and\n235\t    // its tool calls stay in their original order rather than being hoisted.\n236\t    let prose: string[] = [];\n237\t    const flushProse = () => {\n238\t      const text = prose.filter((t) => t.trim()).join(\"\\n\\n\");\n239\t      prose = [];\n240\t      if (text) lines.push(...turnLines(ts, role, text));\n241\t    };\n242\t\n243\t    for (const block of content.blocks) {\n244\t      if (block.type === \"tool_use\") {\n245\t        const callId =\n246\t          typeof block.id === \"string\" && block.id ? block.id : `call_tb_${randomUUID().slice(0, 12)}`;\n247\t        const name = typeof block.name === \"string\" && block.name ? block.name : \"ImportedTool\";\n248\t        seenCallIds.add(callId);\n249\t        flushProse();\n250\t        lines.push(\n251\t          functionCallLine(ts, callId, name, block.input),\n252\t          toolDisplayLine(ts, `[used tool: ${name}]\\ninput: ${JSON.stringify(block.input ?? {})}`),\n253\t        );\n254\t        continue;\n255\t      }\n256\t      if (block.type === \"tool_result\") {\n257\t        const callId = typeof block.tool_use_id === \"string\" ? block.tool_use_id : null;\n258\t        const body =\n259\t          typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n260\t        if (callId && seenCallIds.has(callId)) {\n261\t          flushProse();\n262\t          lines.push(\n263\t            functionCallOutputLine(ts, callId, body),\n264\t            toolDisplayLine(ts, `[tool result]\\n${body}`),\n265\t          );\n266\t        