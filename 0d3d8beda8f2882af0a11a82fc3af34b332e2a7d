{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { chmod, mkdir, readFile, rm, writeFile } from \"node:fs/promises\";\n2\timport { homedir } from \"node:os\";\n3\timport { join } from \"node:path\";\n4\timport { spawnSync } from \"node:child_process\";\n5\timport { configDir } from \"./config.js\";\n6\t\n7\tconst RC_MARKER = \"# added by `turnbridge shim install`\";\n8\t\n9\texport function shimDir(): string {\n10\t  return join(configDir(), \"shims\");\n11\t}\n12\t\n13\t/** Real binary path, skipping our own shim directory. */\n14\tfunction resolveRealBinary(binary: string): string | null {\n15\t  const result = spawnSync(\"which\", [\"-a\", binary], { encoding: \"utf8\" });\n16\t  if (result.status !== 0) return null;\n17\t  const paths = result.stdout.split(\"\\n\").filter(Boolean);\n18\t  return paths.find((p) => !p.startsWith(shimDir())) ?? null;\n19\t}\n20\t\n21\tfunction claudeShim(realPath: string): string {\n22\t  return `#!/bin/sh\n23\t${RC_MARKER}\n24\t# Bare \\`claude --resume\\` opens the turnbridge merged picker; everything else\n25\t# passes through to the real binary.\n26\tif [ \"$#\" -eq 1 ] && { [ \"$1\" = \"--resume\" ] || [ \"$1\" = \"-r\" ]; }; then\n27\t  exec turnbridge resume claude-code\n28\tfi\n29\texec \"${realPath}\" \"$@\"\n30\t`;\n31\t}\n32\t\n33\tfunction codexShim(realPath: string): string {\n34\t  return `#!/bin/sh\n35\t${RC_MARKER}\n36\t# Bare \\`codex resume\\` opens the turnbridge merged picker; everything else\n37\t# passes through to the real binary.\n38\tif [ \"$#\" -eq 1 ] && [ \"$1\" = \"resume\" ]; then\n39\t  exec turnbridge resume codex\n40\tfi\n41\texec \"${realPath}\" \"$@\"\n42\t`;\n43\t}\n44\t\n45\tfunction opencodeShim(realPath: string): string {\n46\t  return `#!/bin/sh\n47\t${RC_MARKER}\n48\t# Bare \\`opencode -s\\` or \\`opencode --session\\` opens the turnbridge merged\n49\t# picker; everything else passes through to the real binary.\n50\tca