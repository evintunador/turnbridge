{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"120\t  return out;\n121\t}\n122\t\n123\t/**\n124\t * Picker title for a bridged session.\n125\t *\n126\t * Verified by scripts/probe-picker.mjs: the picker titles a session by its\n127\t * `ai-title` line, falling back to the first user message when there is none.\n128\t * Fabricated sessions had no such line, so every bridged conversation showed\n129\t * up in the picker titled by turnbridge's own import notice — identical for\n130\t * every bridge, and describing the machinery rather than the conversation.\n131\t * Naming it after the first thing the human actually said is both more useful\n132\t * and closer to what the title would have been natively.\n133\t */\n134\tfunction pickerTitle(summary: ConversationSummary): string {\n135\t  const label = cliLabel(summary.source);\n136\t  for (const event of summary.events) {\n137\t    if (event.actor.type !== \"human\") continue;\n138\t    const content = turnContent(event);\n139\t    const text = content?.blocks\n140\t      .map((b) => (b.type === \"text\" && typeof b.text === \"string\" ? b.text : \"\"))\n141\t      .join(\" \")\n142\t      .trim();\n143\t    if (!text) continue;\n144\t    const oneLine = text.replace(/\\s+/g, \" \");\n145\t    const snippet = oneLine.length > 48 ? `${oneLine.slice(0, 47)}…` : oneLine;\n146\t    return `${snippet} (from ${label})`;\n147\t  }\n148\t  return `Imported from ${label}`;\n149\t}\n150\t\n151\texport function buildSessionLines(\n152\t  summary: ConversationSummary,\n153\t  sessionId: string,\n154\t  cwd: string,\n155\t  version: string,\n156\t  now: Date,\n157\t): FabricatedLine[] {\n158\t  const specs: LineSpec[] = [\n159\t    {\n160\t      type: \"user\",\n161\t      // Fabrication time, which is *newer* than every history line below it, so\n162\t      // the file steps backward exactly once at line 1. Verified deliberate, not\n163\t      // an oversight: probe-session-invariants.mjs resumed both this and a\n164\t      // backdated-monotonic variant with full history intact, so ordering is not\n165\t      // load-bearing for resume. Keeping `now` is the weakly better of two\n166\t      // safe options — if the picker sorts on line timestamps rather than file\n167\t      // mtime, backdating would bury a freshly bridged session under genuinely\n168\t      // old ones, and no reading of the evidence makes it better.\n169\t      timestamp: now.toISOString(),\n170\t      content: [\n171\t        {\n172\t          type: \"text\",\n173\t          text:\n174\t            `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n175\t            \"The history below is the literal visible transcript; hidden reasoning and provider-private \" +\n176\t            \"state were not transferred, and historical tool calls are context only.\",\n177\t        },\n178\t      ],\n179\t    },\n180\t  ];\n181\t\n182\t  const seenToolUseIds = new Set<string>();\n183\t  for (const event of summary.events) {\n184\t    const content = turnContent(event);\n185\t    if (!content) continue;\n186\t    const blocks = convertBlocks(content.blocks, seenToolUseIds);\n187\t    if (blocks.length === 0) continue;\n188\t    // tool results ride on user lines in Claude's format\n189\t    const type = event.actor.type === \"human\" || content.role === \"tool_result\" ? \"user\" : \"assistant\";\n190\t    const spec: LineSpec = {\n191\t      type,\n192\t      content: blocks,\n193\t      timestamp: normalizeTimestamp(event.occurred_at, now),\n194\t    };\n195\t    if (type === \"assistant\" && event.actor.type === \"agent\" && event.actor.id) {\n196\t      spec.model = event.actor.id;\n197\t    }\n198\t    specs.push(spec);\n199\t  }\n200\t\n201\t  const lines: SessionLine[] = [];\n202\t  let parentUuid: string | null = null;\n203\t  for (const spec of specs) {\n204\t    const uuid = randomUUID();\n205\t    const message: Re