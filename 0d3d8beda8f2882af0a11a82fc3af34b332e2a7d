{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { findRepo, gitUserIdentity, type RepoInfo } from \"conversation-ledger\";\n2\timport { writeBootstrapTranscript } from \"./bootstrap.js\";\n3\timport { loadConfig, saveConfig } from \"./config.js\";\n4\timport { listConversations } from \"./conversations.js\";\n5\timport { recordContinuation, readLineage, type Lineage } from \"./lineage.js\";\n6\timport { runLaunchPlan } from \"./launch.js\";\n7\timport { withLedgerNotices } from \"./ledger-io.js\";\n8\timport { confirm, pickFromList } from \"./picker.js\";\n9\timport { installedTargets, targetFor } from \"./targets/index.js\";\n10\timport { formatSize } from \"./transcript.js\";\n11\timport { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \"./targets/types.js\";\n12\timport { cliLabel, type CliName, type ConversationSummary } from \"./types.js\";\n13\timport { turnbridgeVersion } from \"./version.js\";\n14\t\n15\texport interface ResumeFlags {\n16\t  target?: CliName | undefined;\n17\t  all?: boolean;\n18\t  anyCommit?: boolean;\n19\t  bootstrap?: boolean;\n20\t  listOnly?: boolean;\n21\t  noReasoningReplay?: boolean;\n22\t}\n23\t\n24\tfunction relativeTime(iso: string): string {\n25\t  const then = Date.parse(iso);\n26\t  if (Number.isNaN(then)) return iso;\n27\t  const mins = Math.round((Date.now() - then) / 60000);\n28\t  if (mins < 1) return \"just now\";\n29\t  if (mins < 60) return `${mins}m ago`;\n30\t  const hours = Math.round(mins / 60);\n31\t  if (hours < 48) return `${hours}h ago`;\n32\t  return `${Math.round(hours / 24)}d ago`;\n33\t}\n34\t\n35\t/** Lineage annotation for a row: where it came from / where it was bridged. */\n36\tfunction lineageTag(summary: ConversationSummary, lineage: Lineage | undefined): string | null {\n37\t  if (!lineage) return null;\n38\t  const parent = lineage.parentOf.get(summary.id);\n39\t  if (parent) return `↳ continued from ${cliLabel(parent.source.split(\":\")[0] ?? \"\")}`;\n40\t  const children = lineage.childrenOf.get(summary.id);\n41\t  if (children && children.length > 0) {\n42\t    const latest = children.reduce((a, b) => (a.occurredAt > b.occurredAt ? a : b));\n43\t    return `→ bridged to ${cliLabel(latest.targetCli)} ${relativeTime(latest.occurredAt)}`;\n44\t  }\n45\t  return null;\n46\t}\n47\t\n48\texport function renderConversationRow(\n49\t  summary: ConversationSummary,\n50\t  index: number,\n51\t  selfEmail: string | null,\n52\t  lineage?: Lineage,\n53\t): string {\n54\t  const owner =\n55\t    summary.owners.length === 0\n56\t      ? \"author unknown\"\n57\t      : summary.owners.every((o) => o === selfEmail)\n58\t        ? null\n59\t        : summary.ownerDisplays[0] ?? summary.owners[0]!;\n60\t  const parts = [\n61\t    `[${index + 1}]`,\n62\t    cliLabel(summary.source).padEnd(11),\n63\t    relativeTime(summary.lastActivity).padStart(8),\n64\t    `${summary.turnCount} turns`.padStart(9),\n65\t  ];\n66\t  if (owner) parts.push(`by ${owner}`);\n67\t  const tag = lineageTag(summary, lineage);\n68\t  if (tag) parts.push(tag);\n69\t  parts.push(`· ${summary.title}`);\n70\t  return parts.join(\"  \");\n71\t}\n72\t\n73\tasync function chooseTarget(flags: ResumeFlags): Promise<TargetAdapter | null> {\n74\t  if (flags.target) return targetFor(flags.target);\n75\t  const config = await loadConfig();\n76\t  if (config.defaultTarget) return targetFor(config.defaultTarget);\n77\t\n78\t  const installed = await installedTargets();\n79\t  if (installed.length === 0) {\n80\t    process.stderr.write(\"turnbridge: no supported CLI found on PATH (claude, codex, opencode)\\n\");\n81\t    return null;\n82\t  }\n83\t  if (installed.length === 1) return installed[0]!;\n84\t\n85\t  const choice = await pickFromList(\n86\t    installed,\n87\t    (t, i) => `[${i + 1}] ${cliLabel(t.name)}`,\n88\t    \"Resume in which CLI?\",\n89\t  );\n90\t  if (!choice) return null;\n91\t  if (await confirm(`M