{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { spawnSync } from \"node:child_process\";\n2\timport { randomUUID } from \"node:crypto\";\n3\timport { mkdir, writeFile } from \"node:fs/promises\";\n4\timport { homedir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\timport type { EvidenceEvent } from \"conversation-ledger\";\n7\timport { bootstrapPrompt } from \"../bootstrap.js\";\n8\timport { normalizeTimestamp } from \"../timestamps.js\";\n9\timport { formatSize, transcriptSize } from \"../transcript.js\";\n10\timport { binaryOnPath } from \"../launch.js\";\n11\timport { cliLabel, turnContent, type ConversationSummary, type TurnBlock } from \"../types.js\";\n12\timport { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \"./types.js\";\n13\t\n14\t/**\n15\t * Rollout writer validated against codex-cli 0.144.x and 0.145.x (2026-07):\n16\t * resume-by-id scans ~/.codex/sessions for a rollout file whose name and\n17\t * session_meta id match; plain `message` response_items are the replayed\n18\t * conversation state. 0.145.0 revalidated 2026-07-21 via the interactive\n19\t * smoke test plus a headless `codex exec resume` marker-recall probe\n20\t * (scripts/probe-codex-content.mjs).\n21\t */\n22\tconst VALIDATED_VERSION_PREFIXES = [\"0.144.\", \"0.145.\"];\n23\t\n24\tfunction codexVersion(): string | null {\n25\t  const result = spawnSync(\"codex\", [\"--version\"], { encoding: \"utf8\" });\n26\t  if (result.status !== 0) return null;\n27\t  const match = result.stdout.match(/(\\d+\\.\\d+\\.\\d+)/);\n28\t  return match ? match[1]! : null;\n29\t}\n30\t\n31\tfunction sessionsDir(): string {\n32\t  const home = process.env[\"CODEX_HOME\"] ?? join(homedir(), \".codex\");\n33\t  return join(home, \"sessions\");\n34\t}\n35\t\n36\t/** Local-time filename stamp: YYYY-MM-DDTHH-MM-SS. */\n37\tfunction localStamp(d: Date): { datePath: string; stamp: string } {\n38\t  const p = (n: number, w = 2) => String(n).padStart(w, \"0\");\n39\t  const datePath = join(String(d.getFullYear()), p(d.getMonth() + 1), p(d.getDate()));\n40\t  const stamp = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}-${p(d.getMinutes())}-${p(d.getSeconds())}`;\n41\t  return { datePath, stamp };\n42\t}\n43\t\n44\t/**\n45\t * Fold any block into plain text. Only input_text/output_text message blocks\n46\t * are validated to replay safely in Codex, so foreign tool calls become\n47\t * labeled text rather than fabricated function_call records.\n48\t */\n49\tfunction foldBlock(block: TurnBlock): string {\n50\t  switch (block.type) {\n51\t    case \"text\":\n52\t      return typeof block.text === \"string\" ? block.text : \"\";\n53\t    case \"thinking\":\n54\t      return block.text ? `[visible thinking]\\n${String(block.text)}` : \"\";\n55\t    case \"tool_use\":\n56\t      return `[used tool: ${block.name ?? \"unknown\"}]\\ninput: ${JSON.stringify(block.input ?? {})}`;\n57\t    case \"tool_result\": {\n58\t      const body =\n59\t        typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n60\t      return `[tool result]\\n${body}`;\n61\t    }\n62\t    default:\n63\t      return JSON.stringify(block);\n64\t  }\n65\t}\n66\t\n67\tinterface RolloutLine {\n68\t  timestamp: string;\n69\t  type: string;\n70\t  payload: Record<string, unknown>;\n71\t}\n72\t\n73\tfunction messageLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n74\t  const blockType = role === \"assistant\" ? \"output_text\" : \"input_text\";\n75\t  return {\n76\t    timestamp,\n77\t    type: \"response_item\",\n78\t    payload: { type: \"message\", role, content: [{ type: blockType, text }] },\n79\t  };\n80\t}\n81\t\n82\t/**\n83\t * TUI scrollback renders from event_msg records, not response_items; without\n84\t * these the resumed session looks empty even though the model sees history.\n85\t */\n86\tfunction displayLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n87\t  const payload =\n88\t    role === \"user\"\n89\t      ? { type: \"user_message\", message: text, images: [], local_images: [], text_elements: [] }\n90\t      : { type: \"agent_message\", message: text, phase: \"final_answer\", memory_citation: null };\n91\t  return { timestamp, type: \"event_msg\", payload };\n92\t}\n93\t\n94\t/** A conversation turn as both the model-context record and its display twin. */\n95\tfunction turnLines(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine[] {\n96\t  return role === \"user\"\n97\t    ? [displayLine(timestamp, role, text), messageLine(timestamp, role, text)]\n98\t    : [messageLine(timestamp, role, text), displayLine(timestamp, role, text)];\n99\t}\n100\t\n101\t/**\n102\t * A foreign tool call as a real `function_call` response_item.\n103\t *\n104\t * Verified safe by scripts/probe-codex-function-call.mjs (codex-cli 0.145.0):\n105\t * a well-formed call/output pair whose `name` is a tool Codex has never heard\n106\t * of (\"Edit\") replays without API rejection, and the resumed model can name\n107\t * the tool it sees. This closes docs/specs/codex-rollout-format.md §8.2, which\n108\t * had flagged foreign names and orphaned outputs as an unverified rejection\n109\t * risk and recommended text-folding until measured.\n110\t *\n111\t * Pairing is what actually matters: the same probe showed an orphaned\n112\t * `function_call_output` does not error, but carries no `name` at all, so the\n113\t * tool's identity is simply lost. Unpaired results stay text-folded, where the\n114\t * name at least survives as prose.\n115\t */\n116\tfunction functionCallLine(timestamp: string, callId: string, name: string, input: unknown): RolloutLine {\n117\t  return {\n118\t    timestamp,\n119\t    type: \"response_item\",\n120\t    payload: {\n121\t      type: \"function_call\",\n122\t      id: `fc_tb_${callId.slice(-16)}`,\n123\t      name,\n124\t      // the Responses API carries arguments as a JSON *string*, not an object\n125\t      arguments: JSON.stringify(input ?? {}),\n126\t      call_id: callId,\n127\t    },\n128\t  };\n129\t}\n130\t\n131\tfunction functionCallOutputLine(timestamp: string, callId: string, output: string): RolloutLine {\n132\t  return {\n133\t    timestamp,\n134\t    type: \"response_item\",\n135\t    payload: {\n136\t      type: \"function_call_output\",\n137\t      call_id: callId,\n138\t      output: [{ type: \"input_text\", text: output }],\n139\t    },\n140\t  };\n141\t}\n142\t\n143\t/** Codex has no generic tool-call `event_msg`, so scrollback gets prose. */\n144\tfunction toolDisplayLine(timestamp: string, text: string): RolloutLine {\n145\t  return displayLine(timestamp, \"assistant\", text);\n146\t}\n147\t\n148\t/**\n149\t * `reasoning` events this fabrication should replay verbatim: opaque\n150\t * `encrypted_content` only the originating provider can decrypt, which the\n151\t * ledger preserves losslessly (raw.data holds the exact original\n152\t * response_item line) but never interprets. Foreign reasoning cannot be\n153\t * forged as a native reasoning item, so replay is gated per-event on\n154\t * `producer.source === \"codex\"` — the only direction this can ever be\n155\t * valid, regardless of how the rest of the conversation's lineage looks.\n156\t */\n157\tfunction eligibleReasoning(summary: ConversationSummary, replayReasoning: boolean): EvidenceEvent[] {\n158\t  if (!replayReasoning) return [];\n159\t  return summary.events.filter((e) => e.kind === \"reasoning\" && e.producer.source === \"codex\");\n160\t}\n161\t\n162\t/** The verbatim `{type: \"response_item\", payload: {type: \"reasoning\", ...}}` line, if shaped as expected. */\n163\tfunction reasoningRolloutLine(event: EvidenceEvent, now: Date): RolloutLine | null {\n164\t  const line = event.raw?.data as { type?: unknown; payload?: unknown } | undefined;\n165\t  if (line?