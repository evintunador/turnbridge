{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { spawnSync } from \"node:child_process\";\n2\timport { randomUUID } from \"node:crypto\";\n3\timport { mkdir, writeFile } from \"node:fs/promises\";\n4\timport { homedir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\timport type { EvidenceEvent } from \"conversation-ledger\";\n7\timport { bootstrapPrompt } from \"../bootstrap.js\";\n8\timport { normalizeTimestamp } from \"../timestamps.js\";\n9\timport { formatSize, transcriptSize } from \"../transcript.js\";\n10\timport { binaryOnPath } from \"../launch.js\";\n11\timport { cliLabel, turnContent, type ConversationSummary, type TurnBlock } from \"../types.js\";\n12\timport { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \"./types.js\";\n13\t\n14\t/**\n15\t * Rollout writer validated against codex-cli 0.144.x and 0.145.x (2026-07):\n16\t * resume-by-id scans ~/.codex/sessions for a rollout file whose name and\n17\t * session_meta id match; plain `message` response_items are the replayed\n18\t * conversation state. 0.145.0 revalidated 2026-07-21 via the interactive\n19\t * smoke test plus a headless `codex exec resume` marker-recall probe\n20\t * (scripts/probe-codex-content.mjs).\n21\t */\n22\tconst VALIDATED_VERSION_PREFIXES = [\"0.144.\", \"0.145.\"];\n23\t\n24\tfunction codexVersion(): string | null {\n25\t  const result = spawnSync(\"codex\", [\"--version\"], { encoding: \"utf8\" });\n26\t  if (result.status !== 0) return null;\n27\t  const match = result.stdout.match(/(\\d+\\.\\d+\\.\\d+)/);\n28\t  return match ? match[1]! : null;\n29\t}\n30\t\n31\tfunction sessionsDir(): string {\n32\t  const home = process.env[\"CODEX_HOME\"] ?? join(homedir(), \".codex\");\n33\t  return join(home, \"sessions\");\n34\t}\n35\t\n36\t/** Local-time filename stamp: YYYY-MM-DDTHH-MM-SS. */\n37\tfunction localStamp(d: Date): { datePath: string; stamp: string } {\n38\t  const p = (n: number, w = 2) => String(n).padStart(w, \"0\");\n39\t  const datePath = join(String(d.getFullYear()), p(d.getMonth() + 1), p(d.getDate()));\n40\t  const stamp = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}-${p(d.getMinutes())}-${p(d.getSeconds())}`;\n41\t  return { datePath, stamp };\n42\t}\n43\t\n44\t/**\n45\t * Fold any block into plain text. Only input_text/output_text message blocks\n46\t * are validated to replay safely in Codex, so foreign tool calls become\n47\t * labeled text rather than fabricated function_call records.\n48\t */\n49\tfunction foldBlock(block: TurnBlock): string {\n50\t  switch (block.type) {\n51\t    case \"text\":\n52\t      return typeof block.text === \"string\" ? block.text : \"\";\n53\t    case \"thinking\":\n54\t      return block.text ? `[visible thinking]\\n${String(block.text)}` : \"\";\n55\t    case \"tool_use\":\n56\t      return `[used tool: ${block.name ?? \"unknown\"}]\\ninput: ${JSON.stringify(block.input ?? {})}`;\n57\t    case \"tool_result\": {\n58\t      const body =\n59\t        typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n60\t      return `[tool result]\\n${body}`;\n61\t    }\n62\t    default:\n63\t      return JSON.stringify(block);\n64\t  }\n65\t}\n66\t\n67\tinterface RolloutLine {\n68\t  timestamp: string;\n69\t  type: string;\n70\t  payload: Record<string, unknown>;\n71\t}\n72\t\n73\tfunction messageLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n74\t  const blockType = role === \"assistant\" ? \"output_text\" : \"input_text\";\n75\t  return {\n76\t    timestamp,\n77\t    type: \"response_item\",\n78\t    payload: { type: \"message\", role, content: [{ type: blockType, text }] },\n79\t  };\n80\t}\n81\t\n82\t/**\n83\t * TUI scrollback renders from event_msg records, not response_items; without\n84\t * these the resumed session looks empty even though the model sees history.\n85\t */\n86\tfunction displayLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n87\t  const payload =\n88\t    role === \"user\"\n89\t      ? { type: \"user_message\", message: text, images: [], local_images: [], text_elements: [] }\n90\t      : { type: \"agent_message\", message: text, phase: \"final_answer\", memory_citation: null };\n91\t  return { timestamp, type: \"event_msg\", payload };\n92\t}\n93\t\n94\t/** A conversation turn as both the model-context record and its display twin. */\n95\tfunction turnLines(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine[] {\n96\t  return role === \"user\"\n97\t    ? [displayLine(timestamp, role, text), messageLine(timestamp, role, text)]\n98\t    : [messageLine(timestamp, role, text), displayLine(timestamp, role, text)];\n99\t}\n100\t\n101\t/**\n102\t * A foreign tool call as a real `function_call` response_item.\n103\t *\n104\t * Verified safe by scripts/probe-codex-function-call.mjs (codex-cli 0.145.0):\n105\t * a well-formed call/output pair whose `name` is a tool Codex has never heard\n106\t * of (\"Edit\") replays without API rejection, and the resumed model can name\n107\t * the tool it sees. This closes docs/specs/codex-rollout-format.md §8.2, which\n108\t * had flagged foreign names and orphaned outputs as an unverified rejection\n109\t * risk and recommended text-folding until measured.\n110\t *\n111\t * Pairing is what actually matters: the same probe showed an orphaned\n112\t * `function_call_output` does not error, but carries no `name` at all, so the\n113\t * tool's identity is simply lost. Unpaired results stay text-folded, where the\n114\t * name at least survives as prose.\n115\t */\n116\tfunction functionCallLine(timestamp: string, callId: string, name: string, input: unknown): RolloutLine {\n117\t  return {\n118\t    timestamp,\n119\t    type: \"response_item\",\n120\t    payload: {\n121\t      type: \"function_call\",\n122\t      id: `fc_tb_${callId.slice(-16)}`,\n123\t      name,\n124\t      // the Responses API carries arguments as a JSON *string*, not an object\n125\t      arguments: JSON.stringify(input ?? {}),\n126\t      call_id: callId,\n127\t    },\n128\t  };\n129\t}\n130\t\n131\tfunction functionCallOutputLine(timestamp: string, callId: string, output: string): RolloutLine {\n132\t  return {\n133\t    timestamp,\n134\t    type: \"response_item\",\n135\t    payload: {\n136\t      type: \"function_call_output\",\n137\t      call_id: callId,\n138\t      output: [{ type: \"input_text\", text: output }],\n139\t    },\n140\t  };\n141\t}\n142\t\n143\t/** Codex has no generic tool-call `event_msg`, so scrollback gets prose. */\n144\tfunction toolDisplayLine(timestamp: string, text: string): RolloutLine {\n145\t  return displayLine(timestamp, \"assistant\", text);\n146\t}\n147\t\n148\t/**\n149\t * `reasoning` events this fabrication should replay verbatim: opaque\n150\t * `encrypted_content` only the originating provider can decrypt, which the\n151\t * ledger preserves losslessly (raw.data holds the exact original\n152\t * response_item line) but never interprets. Foreign reasoning cannot be\n153\t * forged as a native reasoning item, so replay is gated per-event on\n154\t * `producer.source === \"codex\"` — the only direction this can ever be\n155\t * valid, regardless of how the rest of the conversation's lineage looks.\n156\t */\n157\tfunction eligibleReasoning(summary: ConversationSummary, replayReasoning: boolean): EvidenceEvent[] {\n158\t  if (!replayReasoning) return [];\n159\t  return summary.events.filter((e) => e.kind === \"reasoning\" && e.producer.source === \"codex\");\n160\t}\n161\t\n162\t/** The verbatim `{type: \"response_item\", payload: {type: \"reasoning\", ...}}` line, if shaped as expected. */\n163\tfunction reasoningRolloutLine(event: EvidenceEvent, now: Date): RolloutLine | null {\n164\t  const line = event.raw?.data as { type?: unknown; payload?: unknown } | undefined;\n165\t  if (line?.type !== \"response_item\" || !line.payload || typeof line.payload !== \"object\") return null;\n166\t  return {\n167\t    // Outer rollout field only — `payload` (where the ciphertext lives) stays\n168\t    // byte-identical, since that is what the provider has to be able to decrypt.\n169\t    timestamp: normalizeTimestamp(event.occurred_at, now),\n170\t    type: \"response_item\",\n171\t    payload: line.payload as Record<string, unknown>,\n172\t  };\n173\t}\n174\t\n175\texport function buildRolloutLines(\n176\t  summary: ConversationSummary,\n177\t  sessionId: string,\n178\t  cwd: string,\n179\t  cliVersion: string,\n180\t  now: Date,\n181\t  replayReasoning = true,\n182\t): RolloutLine[] {\n183\t  const nowIso = now.toISOString();\n184\t  const replayCount = eligibleReasoning(summary, replayReasoning).length;\n185\t  // The notice is a factual claim about this specific file, so it has to track\n186\t  // what was actually written: tool calls now replay as real function_call\n187\t  // records (history the model reads, never re-executed), except unpaired\n188\t  // results, which stay prose.\n189\t  const noticeText =\n190\t    `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n191\t    \"The history below is the literal visible transcript. Past tool calls are replayed as history \" +\n192\t    \"records, not as calls to re-run; tool results with no matching call appear as labeled text. \" +\n193\t    (replayCount > 0\n194\t      ? `${replayCount} encrypted reasoning block(s) from the original Codex session were replayed ` +\n195\t        \"verbatim below, which may restore hidden reasoning provider-side; all other hidden reasoning \" +\n196\t        \"and provider-private state were not transferred.\"\n197\t      : \"Hidden reasoning and provider-private state were not transferred.\");\n198\t\n199\t  const lines: RolloutLine[] = [\n200\t    {\n201\t      timestamp: nowIso,\n202\t      type: \"session_meta\",\n203\t      payload: {\n204\t        session_id: sessionId,\n205\t        id: sessionId,\n206\t        timestamp: nowIso,\n207\t        cwd,\n208\t        originator: \"codex-tui\",\n209\t        cli_version: cliVersion,\n210\t        source: \"cli\",\n211\t        thread_source: \"user\",\n212\t        model_provider: \"openai\",\n213\t        history_mode: \"legacy\",\n214\t      },\n215\t    },\n216\t    ...turnLines(nowIso, \"user\", noticeText),\n217\t  ];\n218\t\n219\t  // call_ids seen so far, so a tool_result can tell a real pairing from an\n220\t  // orphan whose matching call never made it into this conversation\n221\t  const seenCallIds = new Set<string>();\n222\t  for (const event of summary.events) {\n223\t    if (event.kind === \"reasoning\") {\n224\t      if (!replayReasoning || event.producer.source !== \"codex\") continue;\n225\t      const line = reasoningRolloutLine(event, now);\n226\t      if (line) lines.push(line);\n227\t      continue;\n228\t    }\n229\t    const content = turnContent(event);\n230\t    if (!content) continue;\n231\t    const ts = normalizeTimestamp(event.occurred_at, now);\n232\t    const role = event.actor.type === \"human\" ? \"user\" : \"assistant\";\n233\t\n234\t    // Prose accumulates until a tool block interrupts it, so a turn's text and\n235\t    // its tool calls stay in their original order rather than being hoisted.\n236\t    let prose: string[] = [];\n237\t    const flushProse = () => {\n238\t      const text = prose.filter((t) => t.trim()).join(\"\\n\\n\");\n239\t      prose = [];\n240\t      if (text) lines.push(...turnLines(ts, role, text));\n241\t    };\n242\t\n243\t    for (const block of content.blocks) {\n244\t      if (block.type === \"tool_use\") {\n245\t        const callId =\n246\t          typeof block.id === \"string\" && block.id ? block.id : `call_tb_${randomUUID().slice(0, 12)}`;\n247\t        const name = typeof block.name === \"string\" && block.name ? block.name : \"ImportedTool\";\n248\t        seenCallIds.add(callId);\n249\t        flushProse();\n250\t        lines.push(\n251\t          functionCallLine(ts, callId, name, block.input),\n252\t          toolDisplayLine(ts, `[used tool: ${name}]\\ninput: ${JSON.stringify(block.input ?? {})}`),\n253\t        );\n254\t        continue;\n255\t      }\n256\t      if (block.type === \"tool_result\") {\n257\t        const callId = typeof block.tool_use_id === \"string\" ? block.tool_use_id : null;\n258\t        const body =\n259\t          typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n260\t        if (callId && seenCallIds.has(callId)) {\n261\t          flushProse();\n262\t          lines.push(\n263\t            functionCallOutputLine(ts, callId, body),\n264\t            toolDisplayLine(ts, `[tool result]\\n${body}`),\n265\t          );\n266\t        } else {\n267\t          // unpaired: an orphaned function_call_output would drop the tool's\n268\t          // identity entirely, so keep it as prose where the label survives\n269\t          prose.push(foldBlock(block));\n270\t        }\n271\t        continue;\n272\t      }\n273\t      prose.push(foldBlock(block));\n274\t    }\n275\t    flushProse();\n276\t  }\n277\t  return lines;\n278\t}\n279\t\n280\texport const codexTarget: TargetAdapter = {\n281\t  name: \"codex\",\n282\t  binary: \"codex\",\n283\t\n284\t  isInstalled() {\n285\t    return binaryOnPath(\"codex\");\n286\t  },\n287\t\n288\t  nativeResume(sessionId: string, cwd: string): LaunchPlan {\n289\t    return {\n290\t      command: \"codex\",\n291\t      args: [\"resume\", sessionId],\n292\t      cwd,\n293\t      notes: [`resuming native Codex session ${sessionId}`],\n294\t    };\n295\t  },\n296\t\n297\t  async fabricate(\n298\t    summary: ConversationSummary,\n299\t    cwd: string,\n300\t    opts: { replayReasoning: boolean },\n301\t  ): Promise<LaunchPlan> {\n302\t    const version = codexVersion();\n303\t    if (!version) {\n304\t      throw new FabricationUnsupportedError(\"could not determine codex version\", \"codex\");\n305\t    }\n306\t    const notes: string[] = [];\n307\t    if (!VALIDATED_VERSION_PREFIXES.some((p) => version.startsWith(p))) {\n308\t      notes.push(\n309\t        `codex ${version} has not been validated against the fabrication spec (validated: ${VALIDATED_VERSION_PREFIXES.map((p) => `${p}x`).join(\", \")}); ` +\n310\t          \"rerun with --bootstrap if the resumed session misbehaves\",\n311\t      );\n312\t    }\n313\t\n314\t    const sessionId = randomUUID();\n315\t    const now = new Date();\n316\t    const { datePath, stamp } = localStamp(now);\n317\t    const dir = join(sessionsDir(), datePath);\n318\t    await mkdir(dir, { recursive: true });\n319\t    const path = join(dir, `rollout-${stamp}-${sessionId}.jsonl`);\n320\t    const lines = buildRolloutLines(summary, sessionId, cwd, version, now, opts.replayReasoning);\n321\t    const body = lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\";\n322\t    await writeFile(path, body);\n323\t\n324\t    notes.push(\n325\t      `fabricated Codex session ${sessionId} from ${cliLabel(summary.source)} history (${summary.turnCount} turns)`,\n326\t      `rollout file: ${path} (${formatSize(transcriptSize(body))})`,\n327\t    );\n328\t    const replayCount = eligibleReasoning(summary, opts.replayReasoning).length;\n329\t    if (replayCount > 0) {\n330\t      notes.push(\n331\t        `replayed ${replayCount} encrypted reasoning block(s) from the original Codex session verbatim ` +\n332\t          \"(may restore hidden reasoning provider-side; disable with reasoningReplay: false in \" +\n333\t          \"~/.turnbridge/config.json or --no-reasoning-replay)\",\n334\t      );\n335\t    }\n336\t    return {\n337\t      command: \"codex\",\n338\t      args: [\"resume\", sessionId],\n339\t      cwd,\n340\t      notes,\n341\t      fabricatedConversationId: `codex:${sessionId}`,\n342\t    };\n343\t  },\n344\t\n345\t  bootstrap(summary: ConversationSummary, cw