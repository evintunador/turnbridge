ng }).role ?? \"\"}`);\n    assert.deepEqual(kinds.slice(3), [\n      \"event_msg:user_message\",\n      \"response_item:messageuser\",\n      \"response_item:messageassistant\",\n      \"event_msg:agent_message\",\n    ]);\n\n    // every line JSON-serializable and carrying a UTC timestamp\n    for (const line of lines) {\n      assert.doesNotThrow(() => JSON.parse(JSON.stringify(line)));\n      assert.match(line.timestamp, /Z$/);\n    }\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"replays a Codex-origin reasoning blob verbatim, in seq order, and updates the notice\", async () => {\n  const repo = await makeTempRepo();","filePath":"/Users/evintunador/repos/evintunador/turnbridge/.claude/worktrees/opencode-fixes/src/test/codex-fabricate.test.ts","numLines":75,"startLine":1,"totalLines":280},"type":"text"},"type":"user","userType":"external","uuid":"c74ac80a-c0bc-4a86-8970-408822933bba","version":"2.1.220"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-03T00:53:33.909Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport assert from \"node:assert/strict\";\n2\timport { test } from \"node:test\";\n3\timport type { ConversationSummary } from \"../types.js\";\n4\timport { buildSessionLines, conversationLines } from \"../targets/claude-code.js\";\n5\timport { buildRolloutLines } from \"../targets/codex.js\";\n6\timport { isNonDecreasing, normalizeTimestamp } from \"../timestamps.js\";\n7\timport { turnDraft } from \"./helpers.js\";\n8\t\n9\t/**\n10\t * Invariants the format specs call out as \"untested — recommend always doing\n11\t * X\" (docs/specs/claude-session-format.md §7). turnbridge already satisfies\n12\t * them by construction; these lock that in so a refactor can't quietly\n13\t * regress into the undefined-behavior territory the specs warn about.\n14\t */\n15\t\n16\tconst NOW = new Date(\"2026-07-27T12:00:00.000Z\");\n17\t\n18\tfunction summaryOf(\n19\t  source: string,\n20\t  turns: Array<{ role: \"user\" | \"assistant\"; text: string; occurredAt?: string }>,\n21\t): ConversationSummary {\n22\t  const id = `${source}:11111111-2222-3333-4444-555555555555`;\n23\t  const events = turns.map((t, i) =>\n24\t    turnDraft(id, source, {\n25\t      role: t.role,\n26\t      text: t.text,\n27\t      seq: i + 1,\n28\t      ...(t.occurredAt ? { occurredAt: t.occurredAt } : {}),\n29\t    }),\n30\t  );\n31\t  return {\n32\t    id,\n33\t    source,\n34\t    sessionId: id.split(\":\").slice(1).join(\":\"),\n35\t    turnCount: turns.length,\n36\t    firstActivity: events[0]?.occurred_at ?? NOW.toISOString(),\n37\t    lastActivity: events[events.length - 1]?.occurred_at ?? NOW.toISOString(),\n38\t    events,\n39\t  } as unknown as ConversationSummary;\n40\t}\n41\t\n42\tconst SAMPLE = summaryOf(\"codex\", [\n43\t  { role: \"user\", text: \"first question\" },\n44\t  { role: \"assistant\", text: \"first answer\" },\n45\t  { role: \"user\", text: \"second question\" },\n46\t