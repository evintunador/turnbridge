sationSummary } from \\\"../types.js\\\";\\nsrc/targets/types.ts:22:  name: CliName;\\nsrc/targets/types.ts:31:   * FabricationUnsupportedError when the installed CLI version is unverified.\\nsrc/targets/types.ts:34:   * `producer.source === \\\"codex\\\"` — most targets ignore the flag entirely).\\nsrc/targets/types.ts:45:export class FabricationUnsupportedError extends Error {\\nsrc/targets/types.ts:48:    public readonly cliName: CliName,\\nsrc/targets/index.ts:1:import type { CliName } from \\\"../types.js\\\";\\nsrc/targets/index.ts:7:export const targets: Record<CliName, TargetAdapter> = {\\nsrc/targets/index.ts:13:export function targetFor(name: CliName): TargetAdapter {\\nsrc/targets/codex.ts:18:import { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \\\"./types.js\\\";\\nsrc/targets/codex.ts:33:  const result = spawnSync(\\\"codex\\\", [\\\"--version\\\"], { encoding: \\\"utf8\\\" });\\nsrc/targets/codex.ts:162: * `producer.source === \\\"codex\\\"` — the only direction this can ever be\\nsrc/targets/codex.ts:167:  return summary.events.filter((e) => e.kind === \\\"reasoning\\\" && e.producer.source === \\\"codex\\\");\\nsrc/targets/codex.ts:236:        cli_version: cliVersion,\\nsrc/targets/codex.ts:251:      if (!replayReasoning || event.producer.source !== \\\"codex\\\") continue;\\nsrc/targets/codex.ts:334:    const version = codexVersion();\\nsrc/targets/codex.ts:335:    if (!version) {\\nsrc/targets/codex.ts:336:      throw new FabricationUnsupportedError(\\\"could not determine codex version\\\", \\\"codex\\\");\\nsrc/targets/codex.ts:339:    if (!VALIDATED_VERSION_PREFIXES.some((p) => version.startsWith(p))) {\\nsrc/targets/codex.ts:341:        `codex ${version} has not been validated against the fabrication spec (validated: ${VALIDATED_VERSION_PREFIXES.map((p) => `${p}x`).join(\\\", \\\")}); ` +\\nsrc/targets/codex.ts:357:      version,\\nsrc/targets/claude-code.ts:17:import { FabricationUnsupportedError, type LaunchPlan, t