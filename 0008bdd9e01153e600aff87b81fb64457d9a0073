  }\\n   287\\t    const config = await loadConfig(ledger);\\n   288\\t    const tier: \\\"standard\\\" | \\\"paranoid\\\" =\\n   289\\t      requestedTier === \\\"paranoid\\\" || config.scan?.tier === \\\"paranoid\\\" ? \\\"paranoid\\\" : \\\"standard\\\";\\n   290\\t    const events = await readEvents(ledger, { reachableFrom: null });\\n   291\\t    const byId = new Map(events.map((event) => [event.id, event]));\\n   292\\t    const findings = filterFindings(scanEvents(events, tier), await loadAllowlist(ledger, config));\\n   293\\t    const body = findings\\n   294\\t      .map((finding) => {\\n   295\\t        const event = byId.get(finding.eventId);\\n   296\\t        return event\\n   297\\t          ? renderFinding(event, finding, {\\n   298\\t              context: numberFlag(parsed, \\\"context\\\", 120),\\n   299\\t              reveal: parsed.flags.has(\\\"reveal\\\"),\\n   300\\t            })\\n   301\\t          : `event ${finding.eventId} is no longer present\\\\n`;\\n   302\\t      })\\n   303\\t      .join(\\\"\\\\n\\\");\\n   304\\t    await writePrivateFile(output, body || \\\"No outstanding findings.\\\\n\\\", parsed.flags.has(\\\"overwrite\\\"));\\n   305\\t    stderr.write(`inspect: wrote ${findings.length} finding site(s) to ${output}\\\\n`);\\n   306\\t    return findings.length === 0 ? 0 : 1;\\n   307\\t  }\\n   308\\t\\n   309\\t  if (command === \\\"redact\\\") {\\n   310\\t    assertFlags(parsed, [\\\"all\\\", \\\"pattern\\\", \\\"reason\\\"]);\\n   311\\t    requireHuman(env, `${commandName} redact`);\\n   312\\t    if (parsed.positional.length !== 1) badUsage(\\\"redact requires one event id prefix\\\");\\n   313\\t    const pattern = stringFlag(parsed, \\\"pattern\\\");\\n   314\\t    const all = parsed.flags.has(\\\"all\\\");\\n   315\\t    if ((pattern !== undefined) === all) badUsage(\\\"redact requires exactly one of --pattern or --all\\\");\\n   316\\t    const reason = stringFlag(parsed, \\\"reason\\\");\\n   317\\t    const result = await redactEvent(ledger, parsed.positional[0]!, {\\n   318\\t      ...(pattern === undefined ? {} : { pattern }),\\n   319\\t      ...(all ? { all: true } : {}),\\n   320\\t      ...(reason === undefined ? {} : { reason }),\\n   321\\t    });\\n   322\\t    stderr.write(`redact: rewrote ${result.event.id.slice(0, 16)} and recorded an audit event\\\\n`);\\n   323\\t    return 0;\\n   324\\t  }\\n   325\\t\\n   326\\t  if (command === \\\"allow\\\") {\\n   327\\t    assertFlags(parsed, [\\\"global\\\"]);\\n   328\\t    requireHuman(env, `${commandName} allow`);\\n   329\\t    if (parsed.positional.length === 0) badUsage(\\\"allow requires at least one fingerprint\\\");\\n   330\\t    for (const fingerprint of parsed.positional) {\\n   331\\t      if (!/^[0-9a-f]{12}$/.test(fingerprint)) badUsage(`invalid fingerprint \\\"${fingerprint}\\\"`);\\n   332\\t    }\\n   333\\t    const scope = parsed.flags.has(\\\"global\\\") ? \\\"global\\\" : \\\"local\\\";\\n   334\\t    await addToAllowlist(ledger, parsed.positional, scope);\\n   335\\t    stderr.write(`allow: added ${parsed.positional.length} fingerprint(s) to the ${scope} allowlist\\\\n`);\\n   336\\t    return 0;\\n   337\\t  }\\n   338\\t\\n   339\\t  if (command === \\\"reanchor\\\" || command === \\\"re-anchor\\\") {\\n   340\\t    assertFlags(parsed, [\\\"apply\\\", \\\"onto\\\", \\\"target\\\"]);\\n   341\\t    if (parsed.positional[0] === \\\"manual\\\") {\\n   342\\t      requireHuman(env, `${commandName} reanchor manual`);\\n   343\\t      const superseded = parsed.positional.slice(1);\\n   344\\t      const onto = stringFlag(parsed, \\\"onto\\\");\\n   345\\t      if (!onto || superseded.length === 0) {\\n   346\\t        badUsage(\\\"reanchor manual requires OLD_REV... --onto NEW_REV\\\");\\n   347\\t      }\\n   348\\t      const result = await manualReAnchor(ledger, superseded, onto);\\n   349\\t      stderr.write(\\n   350\\t        `reanchor: mapped ${result.superseded.length} commit(s) to ${result