,\"original_token_count\":2758,\"output\":\"     1\\t#!/usr/bin/env node\\n     2\\timport { runRecordsCommand } from \\\"annals\\\";\\n     3\\timport { asLedger, findRepo } from \\\"conversation-ledger\\\";\\n     4\\timport { resumeCommand, type ResumeFlags } from \\\"./resume.js\\\";\\n     5\\timport { shimInstall, shimStatus, shimUninstall } from \\\"./shim.js\\\";\\n     6\\timport { parseCliName } from \\\"./types.js\\\";\\n     7\\t\\n     8\\tconst USAGE = `turnbridge — continue a coding-agent conversation in another CLI\\n     9\\t\\n    10\\tUsage:\\n    11\\t  turnbridge resume [claude|codex|opencode] [options]   pick a conversation and resume it\\n    12\\t  turnbridge list [options]                            print compatible conversations\\n    13\\t  turnbridge shim install|uninstall|status             opt-in \\\\`claude --resume\\\\` interception\\n    14\\t  turnbridge records <command>                         maintain shared cledger records\\n    15\\t\\n    16\\tOptions for resume/list:\\n    17\\t  --all         include collaborators' conversations (default: yours + unattributed)\\n    18\\t  --any-commit  include conversations anchored to commits not reachable from HEAD\\n    19\\t  --bootstrap   force honest rehydration (fresh session reads the transcript)\\n    20\\t                instead of fabricating a native session file\\n    21\\t  --no-reasoning-replay\\n    22\\t                don't replay Codex-origin encrypted reasoning blobs when\\n    23\\t                fabricating back into Codex (default: replay them)\\n    24\\t`;\\n    25\\t\\n    26\\tconst RECORD_ALIASES = new Map([\\n    27\\t  [\\\"sync\\\", \\\"sync\\\"],\\n    28\\t  [\\\"review\\\", \\\"review\\\"],\\n    29\\t  [\\\"inspect\\\", \\\"inspect\\\"],\\n    30\\t  [\\\"redact\\\", \\\"redact\\\"],\\n    31\\t  [\\\"allow\\\", \\\"allow\\\"],\\n    32\\t  [\\\"reanchor\\\", \\\"reanchor\\\"],\\n    33\\t  [\\\"re-anchor\\\", \\\"reanchor\\\"],\\n    34\\t]);\\n    35\\t\\n    36\\tasync function recordsCommand(argv: string[]): Promise<number> {\\n    37\\t  // cledger alone owns the pre-push hook ABI for this shared namespace.\\n    38\\t  if (argv[0] === \\\"transport-push\\\") {\\n    39\\t    process.stderr.write(\\\"turnbridge records: use cledger transport-push for the shared hook\\\\n\\\");\\n    40\\t    return 2;\\n    41\\t  }\\n    42\\t  const repo = await findRepo(process.cwd());\\n    43\\t  if (!repo) {\\n    44\\t    process.stderr.write(\\\"turnbridge records: run inside a git repository\\\\n\\\");\\n    45\\t    return 1;\\n    46\\t  }\\n    47\\t  return runRecordsCommand({\\n    48\\t    ledger: asLedger(repo),\\n    49\\t    argv,\\n    50\\t    stdin: process.stdin,\\n    51\\t    stdout: process.stdout,\\n    52\\t    stderr: process.stderr,\\n    53\\t    env: process.env,\\n    54\\t    commandName: \\\"turnbridge records\\\",\\n    55\\t  });\\n    56\\t}\\n    57\\t\\n    58\\tasync function main(argv: string[]): Promise<number> {\\n    59\\t  const args = [...argv];\\n    60\\t  const command = args.shift();\\n    61\\t\\n    62\\t  if (!command || command === \\\"help\\\" || command === \\\"--help\\\" || command === \\\"-h\\\") {\\n    63\\t    process.stdout.write(USAGE);\\n    64\\t    return command ? 0 : 1;\\n    65\\t  }\\n    66\\t\\n    67\\t  if (command === \\\"records\\\") return recordsCommand(args);\\n    68\\t  const recordAlias = RECORD_ALIASES.get(command);\\n    69\\t  if (recordAlias) return recordsCommand([recordAlias, ...args]);\\n    70\\t\\n    71\\t  if (command === \\\"resume\\\" || command === \\\"list\\\") {\\n    72\\t    const flags: ResumeFlags = { listOnly: command === \\\"list\\\" };\\n    73\\t    for (const arg of args) {\\n    74\\t      if (arg === \\\"--all\\\" || arg === \\\"-a\\\") flags.all = true;\\n    75\\t      else if (arg === \\\"--any-commit\\\") flags.anyCommit = true;\\n    76\\t      else if (arg === \\\"--bootstrap\\\") flags.bootstrap = true;\\n    77\\