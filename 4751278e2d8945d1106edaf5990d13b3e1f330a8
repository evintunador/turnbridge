{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"55\t\n56\t/**\n57\t * Convert canonical blocks to Claude-native content blocks. Foreign tool\n58\t * calls keep their names (history is replayed as context, never re-executed);\n59\t * thinking blocks are folded to labeled text — their signatures can't be\n60\t * forged and must not be fabricated.\n61\t */\n62\tfunction convertBlocks(\n63\t  blocks: TurnBlock[],\n64\t  seenToolUseIds: Set<string>,\n65\t): unknown[] {\n66\t  const out: unknown[] = [];\n67\t  for (const block of blocks) {\n68\t    switch (block.type) {\n69\t      case \"text\":\n70\t        if (typeof block.text === \"string\" && block.text.trim()) {\n71\t          out.push({ type: \"text\", text: block.text });\n72\t        }\n73\t        break;\n74\t      case \"thinking\":\n75\t        if (block.text) out.push({ type: \"text\", text: `[visible thinking]\\n${String(block.text)}` });\n76\t        break;\n77\t      case \"tool_use\": {\n78\t        const id = typeof block.id === \"string\" ? block.id : `toolu_tb_${randomUUID().slice(0, 8)}`;\n79\t        seenToolUseIds.add(id);\n80\t        const input =\n81\t          block.input && typeof block.input === \"object\" ? block.input : { value: block.input ?? null };\n82\t        out.push({ type: \"tool_use\", id, name: block.name ?? \"ImportedTool\", input });\n83\t        break;\n84\t      }\n85\t      case \"tool_result\": {\n86\t        const id = typeof block.tool_use_id === \"string\" ? block.tool_use_id : null;\n87\t        if (id && seenToolUseIds.has(id)) {\n88\t          const content =\n89\t            typeof block.content === \"string\" ? block.content : JSON.stringify(block.content ?? \"\");\n90\t          out.push({ type: \"tool_result\", tool_use_id: id, content });\n91\t        } else {\n92\t          // orphaned result — replay as labeled text rather than break pairing\n93\t          out.push({\n94\t            type: \"text\",