{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t#!/usr/bin/env node\n2\t/**\n3\t * Adapter drift check: compares each target CLI's latest npm release against\n4\t * the VALIDATED_VERSION_PREFIX pinned in its adapter. Fabrication specs are\n5\t * reverse-engineered and version-pinned (docs/specs/), so a release outside\n6\t * the validated prefix means the adapter needs revalidation.\n7\t *\n8\t * Exit codes: 0 = all validated, 2 = drift detected, 1 = check itself failed.\n9\t * In GitHub Actions, also writes `drift` (true/false) and a markdown `report`\n10\t * to $GITHUB_OUTPUT for downstream issue/PR steps.\n11\t */\n12\timport { readFile, appendFile } from \"node:fs/promises\";\n13\t\n14\tconst TARGETS = [\n15\t  {\n16\t    name: \"Claude Code\",\n17\t    adapter: new URL(\"../src/targets/claude-code.ts\", import.meta.url),\n18\t    npmPackage: \"@anthropic-ai/claude-code\",\n19\t    spec: \"docs/specs/claude-session-format.md\",\n20\t  },\n21\t  {\n22\t    name: \"Codex\",\n23\t    adapter: new URL(\"../src/targets/codex.ts\", import.meta.url),\n24\t    npmPackage: \"@openai/codex\",\n25\t    spec: \"docs/specs/codex-rollout-format.md\",\n26\t  },\n27\t];\n28\t\n29\tasync function pinnedPrefixes(adapterUrl) {\n30\t  const src = await readFile(adapterUrl, \"utf8\");\n31\t  // Single form: VALIDATED_VERSION_PREFIX = \"2.\" — or array form:\n32\t  // VALIDATED_VERSION_PREFIXES = [\"0.144.\", \"0.145.\"]\n33\t  const m = src.match(/VALIDATED_VERSION_PREFIX(?:ES)?\\s*=\\s*(\"[^\"]+\"|\\[[^\\]]+\\])/);\n34\t  if (!m) throw new Error(`no VALIDATED_VERSION_PREFIX(ES) in ${adapterUrl.pathname}`);\n35\t  const prefixes = m[1].match(/\"([^\"]+)\"/g).map((q) => q.slice(1, -1));\n36\t  if (prefixes.length === 0) throw new Error(`empty prefix list in ${adapterUrl.pathname}`);\n37\t  return prefixes;\n38\t}\n39\t\n40\tasync function latestVersion(pkg) {\n41\t  const res = await fetch(`https://registry.npmjs.org/${encodeURIComponent(pkg)}/latest`);\n42\t  if (!res.ok) throw new Error(`npm registry ${res.status} for ${pkg}`);\n43\t  return (await res.json()).version;\n44\t}\n45\t\n46\tconst rows = [];\n47\tlet drift = false;\n48\tfor (const t of TARGETS) {\n49\t  const prefixes = await pinnedPrefixes(t.adapter);\n50\t  const latest = await latestVersion(t.npmPackage);\n51\t  const ok = prefixes.some((p) => latest.startsWith(p));\n52\t  if (!ok) drift = true;\n53\t  const shown = prefixes.map((p) => `${p}x`).join(\", \");\n54\t  rows.push({ ...t, prefix: shown, latest, ok });\n55\t  console.log(`${ok ? \"OK   \" : \"DRIFT\"} ${t.name}: latest ${latest} vs validated ${shown}`);\n56\t}\n57\t\n58\tif (process.env.GITHUB_OUTPUT) {\n59\t  const report = [\n60\t    \"Latest CLI releases have moved outside the version prefixes the fabrication adapters were validated against.\",\n61\t    \"\",\n62\t    \"| Target | Validated prefix | Latest release | Status |\",\n63\t    \"|---|---|---|---|\",\n64\t    ...rows.map(\n65\t      (r) => `| ${r.name} (\\`${r.npmPackage}\\`) | \\`${r.prefix}\\` | \\`${r.latest}\\` | ${r.ok ? \"validated\" : \"**drift**\"} |`,\n66\t    ),\n67\t    \"\",\n68\t    \"Revalidation steps for each drifted target:\",\n69\t    \"1. Re-verify the fabrication spec (`\" + rows.filter((r) => !r.ok).map((r) => r.spec).join(\"`, `\") + \"`) against the new release.\",\n70\t    \"2. Run `npm run smoke:interactive` with the new CLI installed.\",\n71\t    \"3. Widen `VALIDATED_VERSION_PREFIX` (or amend the writer) in the adapter.\",\n72\t  ].join(\"\\n\");\n73\t  await appendFile(\n74\t    process.env.GITHUB_OUTPUT,\n75\t    `drift=${drift}\\nreport<<TB_EOF\\n${report}\\nTB_EOF\\n`,\n76\t  );\n77\t}\n78\tprocess.exit(drift ? 2 : 0);\n79\t","tool_use_id":"toolu_01JsLDUoKNAqsm3bESxpzmNX","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/turnbridge","head":"567ace863bc2b916acd8eb22fa07e9ea3c0c1269","repo":"git@github.