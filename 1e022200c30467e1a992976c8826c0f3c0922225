\n# Stage 2 (commented): hand the issue to a Claude Code action run that\n# re-verifies the spec against the new release and drafts a revalidation PR.\n# Enabling stage 2 needs an ANTHROPIC_API_KEY repo secret — see the TODO.\nname: adapter-drift\non:\n  schedule:\n    - cron: \"17 6 * * *\"\n  workflow_dispatch: {}\n\npermissions:\n  contents: read\n  issues: write\n\njobs:\n  check:\n    runs-on: ubuntu-latest\n    outputs:\n      drift: ${{ steps.drift.outputs.drift }}\n      report: ${{ steps.drift.outputs.report }}\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n      - id: drift\n        run: node scripts/check-adapter-drift.mjs || [ $? -eq 2 ]\n\n  file-issue:\n    needs: check\n    if: needs.check.outputs.drift == 'true'\n    runs-on: ubuntu-latest\n    permissions:\n      issues: write\n    steps:\n      - uses: actions/github-script@v7\n        env:\n          REPORT: ${{ needs.check.outputs.report }}\n        with:\n          script: |\n            const title = \"Adapter drift: target CLI released outside validated version range\";\n            const open = await github.rest.issues.listForRepo({\n              ...context.repo, state: \"open\", labels: \"adapter-drift\",\n            });\n            const body = process.env.REPORT +\n              \"\\n\\n_Automated by .github/workflows/adapter-drift.yml — updates daily while drift persists._\";\n            if (open.data.length > 0) {\n              await github.rest.issues.update({\n                ...context.repo, issue_number: open.data[0].number, body,\n              });\n            } else {\n              await github.rest.issues.create({\n                ...context.repo, title, body, labels: [\"adapter-drift\"],\n              });\n            }\n\n  # TODO(stage 2): agent-drafted revalidation PR. Uncomment once an\n  # ANTHROPIC_API_KEY secret is configured and the repo is comfortable letting\n  # CI push branches. The agent re-reads the pinned spec, diffs it against the\n  # new CLI release's session format, and opens a draft PR (spec amendments +\n  # VALIDATED_VERSION_PREFIX bump) or reports that a human is needed.\n  #\n  # draft-pr:\n  #   needs: [check, file-issue]\n  #   if: needs.check.outputs.drift == 'true'\n  #   runs-on: ubuntu-latest\n  #   permissions:\n  #     contents: write\n  #     pull-requests: write\n  #   steps:\n  #     - uses: actions/checkout@v4\n  #     - uses: anthropics/claude-code-action@v1\n  #       with:\n  #         anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}\n  #         prompt: |\n  #           ${{ needs.check.outputs.report }}\n  #\n  #           Install the drifted CLI release(s), re-verify the fabrication\n  #           spec(s) named above against them (headless probes only), amend\n  #           the spec docs and VALIDATED_VERSION_PREFIX if the format is\n  #           unchanged, run `npm test`, and open a DRAFT pull request with\n  #           your findings. If the format changed materially, do not guess:\n  #           open the PR with the spec diff annotated as needing human\n  #           validation via `npm run smoke:interactive`.\n","filePath":"/Users/evintunador/repos/evintunador/turnbridge/.github/workflows/adapter-drift.yml","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"f98b1a13-9137-4493-be54-f818c4d172a4","version":"2.1.216"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-07-21T22:35:20.986Z","schema":"conversation-ledger/v1"}
