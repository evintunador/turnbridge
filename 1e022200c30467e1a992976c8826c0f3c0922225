dir);\n  if (!repo) throw new Error(\"failed to init smoke repo\");\n\n  const conversationId = `claude-code:${crypto.randomUUID()}`;\n  const turn = (role, text, seq) => ({\n    kind: \"conversation_turn\",\n    occurred_at: `2026-01-01T00:00:0${seq}.000Z`,\n    actor:\n      role === \"user\"\n        ? { type: \"human\", id: \"smoke@turnbridge.test\" }\n        : { type: \"agent\", id: \"smoke-model\" },\n    producer: {\n      tool: \"turnbridge-smoke\",\n      source: \"claude-code\",\n      session_id: conversationId.split(\":\")[1],\n    },\n    conversation: { id: conversationId, seq },\n    content: { role, blocks: [{ type: \"text\", text }] },\n  });\n  await appendEvents(repo, [\n    turn(\"user\", `${USER_MARKER}: please remember this exact marker phrase.`, 0),\n    turn(\n      \"assistant\",\n      `Understood — the marker is ${ASSISTANT_MARKER} and I will recall it on request.`,\n      1,\n    ),\n  ]);\n  await writeFile(join(artifactsDir, \"repo-path.txt\"), dir + \"\\n\");\n  return repo;\n}\n\n/**\n * Run `command` under a pty via macOS/BSD `script -q <log>`, watching the log\n * until `until(stripped)` is true or timeout. `onTick` may send keystrokes\n * (e.g. accept a trust prompt). Returns the final stripped output.\n */\nasync function runInPty({ command, args, cwd, logPath, timeoutMs, until, onTick, quitKeys }) {\n  const child = spawn(\"script\", [\"-q\", logPath, command, ...args], {\n    cwd,\n    stdio: [\"pipe\", \"ignore\", \"pipe\"],\n  });\n  let exited = false;\n  child.on(\"exit\", () => (exited = true));\n\n  const deadline = Date.now() + timeoutMs;\n  let stripped = \"\";\n  let satisfied = false;\n  while (Date.now() < deadline && !exited) {\n    await sleep(500);\n    stripped = stripAnsi(await readFile(logPath, \"utf8\").catch(() => \"\"));\n    if (onTick) onTick(stripped, child);\n    if (until(stripped)) {\n      satisfied = true;\n      break;\n    }\n  }\n  // Render settled (or timed out) — ask the TUI to quit, then force