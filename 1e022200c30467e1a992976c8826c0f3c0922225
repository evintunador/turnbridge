# usage: pty-run.exp <logfile> <settle-seconds> <command> [args...]\nset logf [lindex $argv 0]\nset settle [lindex $argv 1]\nset stty_init \"rows 40 cols 120\"\nlog_file -noappend $logf\n\nspawn -noecho {*}[lrange $argv 2 end]\n\n# Collect output for the settle window; the only pattern we act on is a\n# trust/onboarding prompt (Enter accepts the default \"proceed\"). exp_continue\n# restarts the window, so a trust prompt effectively extends the wait.\nset timeout $settle\nexpect {\n    -re {Do you trust|trust the files|Yes, proceed} {\n        sleep 1\n        send \"\\r\"\n        exp_continue\n    }\n    timeout {}\n    eof { exit 3 }\n}\n\n# Quit: interrupt (twice — both TUIs want a confirming second press), then\n# Ctrl+D, then a hard kill so the harness never hangs on a stuck TUI.\nset timeout 6\nsend \"\\x03\"\nsleep 0.6\nsend \"\\x03\"\nsleep 0.6\nexpect eof { exit 0 }\nsend \"\\x04\"\nexpect eof { exit 0 }\nexec kill -9 [exp_pid]\nexit 0\n","filePath":"/Users/evintunador/repos/evintunador/turnbridge/scripts/pty-run.exp","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"b4a4deb4-134d-41c9-9567-57f6d2dcd4ae","version":"2.1.216"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-07-21T22:35:20.984Z","schema":"conversation-ledger/v1"}
