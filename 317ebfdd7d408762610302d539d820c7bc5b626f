{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { spawnSync } from \"node:child_process\";\n2\timport { randomUUID } from \"node:crypto\";\n3\timport { mkdir, writeFile } from \"node:fs/promises\";\n4\timport { homedir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\timport { bootstrapPrompt } from \"../bootstrap.js\";\n7\timport { binaryOnPath } from \"../launch.js\";\n8\timport { cliLabel, turnContent, type ConversationSummary, type TurnBlock } from \"../types.js\";\n9\timport { FabricationUnsupportedError, type LaunchPlan, type TargetAdapter } from \"./types.js\";\n10\t\n11\t/**\n12\t * Rollout writer validated against codex-cli 0.144.x (2026-07): resume-by-id\n13\t * scans ~/.codex/sessions for a rollout file whose name and session_meta id\n14\t * match; plain `message` response_items are the replayed conversation state.\n15\t */\n16\tconst VALIDATED_VERSION_PREFIX = \"0.144.\";\n17\t\n18\tfunction codexVersion(): string | null {\n19\t  const result = spawnSync(\"codex\", [\"--version\"], { encoding: \"utf8\" });\n20\t  if (result.status !== 0) return null;\n21\t  const match = result.stdout.match(/(\\d+\\.\\d+\\.\\d+)/);\n22\t  return match ? match[1]! : null;\n23\t}\n24\t\n25\tfunction sessionsDir(): string {\n26\t  const home = process.env[\"CODEX_HOME\"] ?? join(homedir(), \".codex\");\n27\t  return join(home, \"sessions\");\n28\t}\n29\t\n30\t/** Local-time filename stamp: YYYY-MM-DDTHH-MM-SS. */\n31\tfunction localStamp(d: Date): { datePath: string; stamp: string } {\n32\t  const p = (n: number, w = 2) => String(n).padStart(w, \"0\");\n33\t  const datePath = join(String(d.getFullYear()), p(d.getMonth() + 1), p(d.getDate()));\n34\t  const stamp = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}-${p(d.getMinutes())}-${p(d.getSeconds())}`;\n35\t  return { datePath, stamp };\n36\t}\n37\t\n38\t/**\n39\t * Fold any block into plain text. Only i