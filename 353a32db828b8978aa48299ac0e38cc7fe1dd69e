{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"62\t}\n63\t\n64\tinterface RolloutLine {\n65\t  timestamp: string;\n66\t  type: string;\n67\t  payload: Record<string, unknown>;\n68\t}\n69\t\n70\tfunction messageLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n71\t  const blockType = role === \"assistant\" ? \"output_text\" : \"input_text\";\n72\t  return {\n73\t    timestamp,\n74\t    type: \"response_item\",\n75\t    payload: { type: \"message\", role, content: [{ type: blockType, text }] },\n76\t  };\n77\t}\n78\t\n79\t/**\n80\t * TUI scrollback renders from event_msg records, not response_items; without\n81\t * these the resumed session looks empty even though the model sees history.\n82\t */\n83\tfunction displayLine(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine {\n84\t  const payload =\n85\t    role === \"user\"\n86\t      ? { type: \"user_message\", message: text, images: [], local_images: [], text_elements: [] }\n87\t      : { type: \"agent_message\", message: text, phase: \"final_answer\", memory_citation: null };\n88\t  return { timestamp, type: \"event_msg\", payload };\n89\t}\n90\t\n91\t/** A conversation turn as both the model-context record and its display twin. */\n92\tfunction turnLines(timestamp: string, role: \"user\" | \"assistant\", text: string): RolloutLine[] {\n93\t  return role === \"user\"\n94\t    ? [displayLine(timestamp, role, text), messageLine(timestamp, role, text)]\n95\t    : [messageLine(timestamp, role, text), displayLine(timestamp, role, text)];\n96\t}\n97\t\n98\texport function buildRolloutLines(\n99\t  summary: ConversationSummary,\n100\t  sessionId: string,\n101\t  cwd: string,\n102\t  cliVersion: string,\n103\t  now: Date,\n104\t): RolloutLine[] {\n105\t  const nowIso = now.toISOString();\n106\t  const lines: RolloutLine[] = [\n107\t    {\n108\t      timestamp: nowIso,\n109\t      type: \"session_meta\",\n110\t      payload: {\n111\t        session_id: sessionId,\n112\t        id: sessionId,\n113\t        timestamp: nowIso,\n114\t        cwd,\n115\t        originator: \"codex-tui\",\n116\t        cli_version: cliVersion,\n117\t        source: \"cli\",\n118\t        thread_source: \"user\",\n119\t        model_provider: \"openai\",\n120\t        history_mode: \"legacy\",\n121\t      },\n122\t    },\n123\t    ...turnLines(\n124\t      nowIso,\n125\t      \"user\",\n126\t      `[turnbridge import notice] This conversation was imported from ${cliLabel(summary.source)}. ` +\n127\t        \"The history below is the literal visible transcript; hidden reasoning and provider-private \" +\n128\t        \"state were not transferred, and past tool calls are shown as labeled text, not replayable calls.\",\n129\t    ),\n130\t  ];\n131\t\n132\t  for (const event of summary.events) {\n133\t    const content = turnContent(event);\n134\t    if (!content) continue;\n135\t    const text = content.blocks.map(foldBlock).filter((t) => t.trim()).join(\"\\n\\n\");\n136\t    if (!text) continue;\n137\t    const role = event.actor.type === \"human\" ? \"user\" : \"assistant\";\n138\t    lines.push(...turnLines(event.occurred_at, role, text));\n139\t  }","tool_use_id":"toolu_017Bzn1omqif4NnmoCqZTPU5","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/turnbridge","head":"353a32db828b8978aa48299ac0e38cc7fe1dd69e","repo":"git@github.com:evintunador/turnbridge.git"},"conversation":{"id":"claude-code:6b979ed9-e38e-4fea-b585-342bba5a333c","seq":542},"id":"ev1-6b3716210b897452e441f19db6824eeb947f10544c728b26f0afe55d2ba0d3a3","kind":"conversation_turn","occurred_at":"2026-07-22T00:03:43.491Z","producer":{"session_id":"6b979ed9-e38e-4fea-b585-342bba5a333c","source":"claude-code","tool":"cledger","version":"0.9.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/turnbridge","entrypoint":"cli","gitBranch":"main","isSidechain":fal