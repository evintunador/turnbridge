{
  "name": "turnbridge",
  "version": "0.6.1",
  "description": "Lossless visible-conversation continuity between coding agent CLIs.",
  "type": "module",
  "license": "MIT",
  "author": "evintunador",
  "repository": {
    "type": "git",
    "url": "https://github.com/evintunador/turnbridge"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "turnbridge": "dist/cli.js",
    "tb": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "coding-agent",
    "claude-code",
    "codex",
    "opencode",
    "resume",
    "session",
    "cross-cli"
  ],
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "LICENSE",
    "scripts/setup-pty.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "smoke:interactive": "npm run verify:installed",
    "verify:plan": "npm run build && node dist/verification/plan.js",
    "verify:report": "npm run build && node dist/verification/report.js",
    "verify:installed": "npm run build && node dist/verification/campaign.js",
    "check:adapter-drift": "node scripts/check-adapter-drift.mjs",
    "prepublishOnly": "node -e \"const local=Object.entries(require('./package.json').dependencies).filter(([,v])=>v.startsWith('file:')).map(([n])=>n); if(local.length) { console.error('refusing to publish: local file: dependencies need published versions: '+local.join(', ')); process.exit(1); }\" && npm test",
    "prepare": "npm run build",
    "verify:program": "npm run build && node dist/verification/program.js",
    "verify:provision": "node scripts/provision-runtimes.mjs",
    "verify:candidates": "node scripts/runtime-candidates.mjs",
    "smoke:legacy": "npm run build && node scripts/smoke-interactive.mjs",
    "postinstall": "node scripts/setup-pty.mjs"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "annals": "file:../annals",
    "conversation-ledger": "file:../conversation-ledger",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
