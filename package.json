{
  "name": "turnbridge",
  "version": "0.4.1",
  "description": "Lossless visible-conversation continuity between coding agent CLIs.",
  "type": "module",
  "license": "MIT",
  "author": "evintunador",
  "repository": {
    "type": "git",
    "url": "https://github.com/evintunador/turnbridge"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "turnbridge": "dist/cli.js",
    "tb": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "coding-agent",
    "claude-code",
    "codex",
    "resume",
    "session",
    "cross-cli"
  ],
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "smoke:interactive": "npm run build && node scripts/smoke-interactive.mjs",
    "check:adapter-drift": "node scripts/check-adapter-drift.mjs",
    "prepublishOnly": "node -e \"const d=require('./package.json').dependencies['conversation-ledger']; if(d.startsWith('file:')) { console.error('refusing to publish: conversation-ledger is still a file: dependency — publish it to npm and pin a semver range first'); process.exit(1); }\" && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "conversation-ledger": "file:../conversation-ledger"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
